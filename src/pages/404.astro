---
import BaseLayout from '../layouts/BaseLayout.astro';
import Portal from '../components/Portal.astro';
import AuroraFondo from '../components/AuroraFondo.astro';
---
<BaseLayout title="Página no encontrada | EOS Studio" description="Esta página no existe." noindex>
  <section class="hero contenedor">
    <AuroraFondo />
    <div class="hero-texto">
      <span class="eyebrow"><span class="letra">Ω</span>Error 404</span>
      <h1>Esta página se ha quedado <em>a oscuras</em></h1>
      <p class="lead">La dirección no existe o ha cambiado. Vuelve al inicio o echa un vistazo a los servicios.</p>
      <div class="hero-botones">
        <a class="btn btn--aurora" href="/">Volver al inicio <span class="flecha">→</span></a>
        <a class="btn btn--linea" href="/servicios/">Ver servicios</a>
      </div>
    </div>
    <Portal escena="404" />
  </section>
</BaseLayout>
