---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AuroraFondo from '../../components/AuroraFondo.astro';
import { render } from 'astro:content';
import { entradas, TIPOS, minutosLectura, fechaLarga, type Entrada } from '../../lib/blog';
import { EQUIPO } from '../../data/equipo';
import { SERVICIOS, urlServicio } from '../../data/servicios';
import { BASE_URL } from '../../lib/seo';

export async function getStaticPaths() {
  const lista = await entradas();
  return lista.map((entrada) => ({ params: { slug: entrada.id }, props: { entrada, lista } }));
}
const { entrada, lista } = Astro.props as { entrada: Entrada; lista: Entrada[] };
const { Content, headings } = await render(entrada);
const d = entrada.data;
const autor = EQUIPO.find((p) => p.nombre === d.autor);
const servicio = d.servicio ? SERVICIOS.find((s) => s.slug === d.servicio && s.publicado) : undefined;
const otras = lista.filter((e) => e.id !== entrada.id).slice(0, 2);
const indice = headings.filter((h) => h.depth === 2);
const url = `${BASE_URL}/blog/${entrada.id}/`;
const schema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: d.titulo,
  description: d.descripcion,
  url,
  mainEntityOfPage: url,
  datePublished: d.fecha.toISOString(),
  dateModified: (d.actualizado ?? d.fecha).toISOString(),
  inLanguage: 'es',
  author: autor
    ? { '@type': 'Person', name: autor.nombre, url: autor.linkedin }
    : { '@id': `${BASE_URL}/#organization` },
  publisher: { '@id': `${BASE_URL}/#organization` },
  keywords: d.etiquetas.join(', '),
};
---
<BaseLayout title={`${d.titulo} | EOS Studio`} description={d.descripcion} schema={schema} migaFinal={d.titulo} ogType="article">
  <section class="hero contenedor hero--simple">
    <AuroraFondo />
    <div class="hero-texto">
      <span class="eyebrow"><span class="letra letra--sin">✦</span>{TIPOS[d.tipo]}</span>
      <h1 class="articulo-h1">{d.titulo}</h1>
      <p class="lead">{d.descripcion}</p>
      <p class="articulo-meta">
        {autor ? <a href={autor.linkedin} target="_blank" rel="noopener">{autor.nombre}</a> : <span>Equipo de EOS Studio</span>}
        {' · '}<time datetime={d.fecha.toISOString()}>{fechaLarga(d.fecha)}</time>
        {d.actualizado && <>{' · actualizado el '}<time datetime={d.actualizado.toISOString()}>{fechaLarga(d.actualizado)}</time></>}
        {` · ${minutosLectura(entrada.body)} min de lectura`}
      </p>
    </div>
  </section>

  <section class="seccion seccion--sin-arriba">
    <div class="contenedor articulo">
      {indice.length > 2 && (
        <nav class="indice" aria-label="Índice">
          <p>En esta guía</p>
          <ol>{indice.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
        </nav>
      )}
      <article class="prosa-larga"><Content /></article>
    </div>
  </section>

  <section class="seccion seccion--piedra">
    <div class="contenedor cierre">
      <div class="cierre-cta aparece">
        <h2>¿Lo aplicamos <em>a tu negocio</em>?</h2>
        <p class="lead">Pide un diagnóstico gratuito y te decimos por dónde empezar.</p>
        <div class="hero-botones">
          <a class="btn btn--aurora" href="/diagnostico/">Diagnóstico gratuito <span class="flecha">→</span></a>
          {servicio && <a class="btn btn--linea" href={urlServicio(servicio.slug)}>Ver {servicio.nombre}</a>}
        </div>
      </div>
      {otras.length > 0 && (
        <div class="otras">
          <p class="otras-t">Sigue leyendo</p>
          <ul>{otras.map((e) => <li><a href={`/blog/${e.id}/`}><span>{TIPOS[e.data.tipo]}</span>{e.data.titulo}</a></li>)}</ul>
        </div>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .articulo-h1{font-size:clamp(2.6rem,5.2vw,4.4rem);max-width:20ch;}
  .articulo-meta{font-size:.92rem;color:var(--tinta-3);}
  .articulo-meta a{color:var(--tinta);}
  .articulo{display:grid;grid-template-columns:240px minmax(0,720px);gap:56px;align-items:start;}
  @media (max-width:980px){ .articulo{grid-template-columns:1fr;gap:24px;} }
  .indice{position:sticky;top:110px;font-size:.92rem;border-left:2px solid var(--terracota);padding-left:18px;}
  .indice p{font-family:var(--etiqueta);letter-spacing:.1em;color:var(--terracota);margin-bottom:10px;}
  .indice ol{list-style:none;display:grid;gap:8px;}
  .indice a{color:var(--tinta-2);text-decoration:none;}
  .indice a:hover{color:var(--aurora-ink);}
  @media (max-width:980px){ .indice{position:static;} }
  .cierre{display:grid;grid-template-columns:1.2fr 1fr;gap:40px;align-items:start;}
  @media (max-width:900px){ .cierre{grid-template-columns:1fr;} }
  .cierre-cta{display:grid;gap:16px;}
  .otras-t{font-family:var(--etiqueta);letter-spacing:.1em;color:var(--terracota);margin-bottom:12px;}
  .otras ul{list-style:none;display:grid;gap:12px;}
  .otras a{display:grid;gap:4px;padding:18px 20px;border-radius:16px;border:1px solid var(--linea);background:rgba(255,255,255,.7);text-decoration:none;color:var(--tinta);font-family:var(--serif);font-size:1.4rem;line-height:1.15;}
  .otras a span{font-family:var(--etiqueta);font-size:.8rem;letter-spacing:.1em;color:var(--terracota);}
  .otras a:hover{border-color:var(--aurora);}
</style>
