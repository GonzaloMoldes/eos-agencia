---
import BaseLayout from '../layouts/BaseLayout.astro';
import AuroraFondo from '../components/AuroraFondo.astro';
import Formulario from '../components/Formulario.astro';
import Iconos from '../components/Iconos.astro';
import { SITIO, whatsappUrl } from '../data/sitio';
import { EQUIPO } from '../data/equipo';
import { BASE_URL } from '../lib/seo';

const pasos = [
  { t: 'Te respondemos', d: 'Te contesta personalmente alguien del equipo, por correo o por teléfono, como prefieras.' },
  { t: 'Hablamos 30 minutos', d: 'Entendemos tu negocio, tus objetivos y tu punto de partida. Sin compromiso.' },
  { t: 'Te enviamos una propuesta', d: 'Con alcance, entregables y precio cerrados. Tú decides si seguimos.' },
];
const schema = { '@context': 'https://schema.org', '@type': 'ContactPage', name: `Contacto · ${SITIO.nombre}`, url: `${BASE_URL}/contacto/` };
---
<BaseLayout
  title="Contacto | EOS Studio, agencia de SEO y marketing en A Coruña y Valencia"
  description="Cuéntanos tu proyecto: formulario, WhatsApp o una llamada de 30 minutos. EOS Studio, agencia de SEO, GEO y marketing en A Coruña y Valencia."
  schema={schema}
>
  <section class="hero contenedor contacto">
    <AuroraFondo />
    <div class="hero-texto">
      <span class="eyebrow"><span class="letra letra--sin">✦</span>Contacto</span>
      <h1>Hablemos de <em>tu proyecto</em></h1>
      <p class="lead">Cuéntanos qué haces, qué quieres conseguir y qué herramientas usas. Te respondemos personalmente.</p>

      <ul class="canales">
        <li>
          <a class="canal canal--wa" href={whatsappUrl()} target="_blank" rel="noopener">
            <span class="canal-icono"><Iconos nombre="whatsapp" tam={22} /></span>
            <span><strong>WhatsApp</strong><small>{SITIO.whatsappVisible}</small></span>
          </a>
        </li>
        {EQUIPO.map((p) => (
          <li>
            <a class="canal" href={`mailto:${p.email}`}>
              <span class="canal-icono">@</span>
              <span><strong>{p.nombre}</strong><small>{p.email}</small></span>
            </a>
          </li>
        ))}
        {SITIO.agenda && (
          <li>
            <a class="canal" href={SITIO.agenda} target="_blank" rel="noopener">
              <span class="canal-icono">◷</span>
              <span><strong>Reserva una llamada</strong><small>30 minutos, sin compromiso</small></span>
            </a>
          </li>
        )}
      </ul>
      <p class="sedes"><span>Sedes</span> {SITIO.sedes.join(' · ')}</p>
    </div>

    <div class="tarjeta form-caja">
      <Formulario tipo="contacto" />
    </div>
  </section>

  {SITIO.agenda && (
    <section class="seccion seccion--sin-arriba" id="agenda">
      <div class="contenedor">
        <div class="cabecera-seccion">
          <span class="eyebrow"><span class="letra">Α</span>Agenda</span>
          <h2>Reserva una llamada <em>de 30 minutos</em></h2>
        </div>
        <div class="agenda">
          <iframe src={SITIO.agenda} title="Reserva una llamada con EOS Studio" loading="lazy"></iframe>
        </div>
      </div>
    </section>
  )}

  <section class="seccion seccion--noche">
    <div class="contenedor">
      <div class="cabecera-seccion">
        <span class="eyebrow"><span class="letra">{SITIO.agenda ? 'Β' : 'Α'}</span>Qué pasa después</span>
        <h2>Tres pasos, <em>sin letra pequeña</em></h2>
      </div>
      <ol class="pasos">
        {pasos.map((p, i) => <li class="aparece"><span class="paso-num">{['I', 'II', 'III'][i]}</span><h3>{p.t}</h3><p>{p.d}</p></li>)}
      </ol>
    </div>
  </section>

  <section class="seccion">
    <div class="contenedor diag-cta aparece">
      <div>
        <h2>¿Prefieres que miremos <em>tu web primero</em>?</h2>
        <p class="lead">Pide un diagnóstico gratuito: revisamos tu web y te decimos por dónde empezar.</p>
      </div>
      <a class="btn btn--tinta" href="/diagnostico/">Pedir diagnóstico gratuito <span class="flecha">→</span></a>
    </div>
  </section>
</BaseLayout>

<style>
  .contacto{grid-template-columns:1fr 1.05fr;align-items:start;}
  @media (max-width:900px){ .contacto{grid-template-columns:1fr;} }
  .form-caja{padding:34px;box-shadow:var(--sombra);}
  .canales{list-style:none;display:grid;gap:10px;margin-top:10px;}
  .canal{display:flex;align-items:center;gap:14px;padding:12px 16px;border-radius:16px;border:1px solid var(--linea);background:rgba(255,255,255,.6);text-decoration:none;color:var(--tinta);transition:transform .2s,border-color .2s;}
  .canal:hover{transform:translateX(4px);border-color:var(--aurora);color:var(--tinta);}
  .canal-icono{display:grid;place-items:center;width:44px;height:44px;border-radius:50%;background:var(--degradado);color:var(--vaso);font-weight:600;flex:none;}
  .canal--wa .canal-icono{background:#25D366;color:#fff;}
  .canal strong{display:block;font-weight:600;}
  .canal small{display:block;color:var(--tinta-3);font-size:.88rem;}
  .sedes{margin-top:8px;color:var(--tinta-2);}
  .sedes span{font-family:var(--etiqueta);letter-spacing:.12em;color:var(--terracota);margin-right:8px;}
  .agenda{border-radius:var(--radio);overflow:hidden;border:1px solid var(--linea);background:#fff;}
  .agenda iframe{display:block;width:100%;height:720px;border:0;}
  .pasos{grid-template-columns:repeat(3,minmax(0,1fr));}
  @media (max-width:900px){ .pasos{grid-template-columns:1fr;} }
  .diag-cta{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:24px;border:1px solid var(--linea);border-radius:28px;padding:40px;background:rgba(255,255,255,.6);}
  .diag-cta h2{font-size:clamp(1.9rem,3.4vw,2.8rem);margin-bottom:8px;}
</style>
