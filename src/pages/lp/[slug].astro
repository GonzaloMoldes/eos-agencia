---
// Landing pages de captación: /lp/<slug>/. Datos en src/data/landings.ts.
// noindex: son para campañas; las páginas que posicionan son las de servicio.
import BaseLayout from '../../layouts/BaseLayout.astro';
import AuroraFondo from '../../components/AuroraFondo.astro';
import Formulario from '../../components/Formulario.astro';
import Experiencia from '../../components/Experiencia.astro';
import Escena from '../../components/Escena.astro';
import Faq from '../../components/Faq.astro';
import { LANDINGS, type Landing } from '../../data/landings';
import { PAGINAS } from '../../data/paginas';
import { SITIO, whatsappUrl } from '../../data/sitio';
import { md } from '../../lib/texto';
import type { Plan } from '../../data/tipos';

export function getStaticPaths() {
  return LANDINGS.map((l) => ({ params: { slug: l.slug }, props: { l } }));
}
const { l } = Astro.props as { l: Landing };

const pagina = PAGINAS.find((p) => p.slug === l.servicio);
if (!pagina) throw new Error(`Landing ${l.slug}: el servicio ${l.servicio} no tiene página`);
const bloquePlanes = pagina.bloques.find((b) => b.tipo === 'planes');
const planes: Plan[] = bloquePlanes && bloquePlanes.tipo === 'planes' ? bloquePlanes.planes : [];
const ROMANOS = ['I', 'II', 'III', 'IV', 'V', 'VI'];
---
<BaseLayout title={l.title} description={l.description} noindex landing={{ cta: l.hero.cta }}>
  <section class="hero contenedor lp-hero">
    <AuroraFondo />
    <div class="hero-texto">
      <span class="eyebrow"><span class="letra letra--sin">✦</span>{l.hero.eyebrow}</span>
      <h1 set:html={l.hero.h1} />
      <p class="lead">{l.hero.intro}</p>
      <ul class="lista-sol">{l.hero.puntos.map((p) => <li set:html={md(p)} />)}</ul>
    </div>
    <div class="tarjeta lp-form" id="formulario">
      <p class="lp-form-titulo">{l.formulario.titulo}</p>
      <p class="lp-form-sub">{l.formulario.subtitulo}</p>
      <Formulario tipo="landing" servicio={l.hero.eyebrow} objetivos={l.formulario.objetivos} boton={l.formulario.boton} />
    </div>
  </section>

  <section class="seccion seccion--piedra">
    <div class="contenedor"><Experiencia /></div>
  </section>

  <section class="seccion">
    <div class="contenedor lp-dos">
      <div>
        <div class="cabecera-seccion">
          <span class="eyebrow"><span class="letra">Α</span>El problema</span>
          <h2 set:html={l.problema.titulo} />
        </div>
        <ol class="lp-dolores aparece">
          {l.problema.puntos.map((p, i) => <li><span class="romano">{ROMANOS[i]}</span><span set:html={md(p)} /></li>)}
        </ol>
      </div>
      <Escena nombre={pagina.escena} class="lp-escena" />
    </div>
  </section>

  <section class="seccion seccion--piedra">
    <div class="contenedor">
      <div class="cabecera-seccion">
        <span class="eyebrow"><span class="letra">Β</span>Qué hacemos</span>
        <h2 set:html={l.trabajo.titulo} />
        <p class="lead" set:html={md(l.trabajo.intro)} />
      </div>
      <div class="rejilla rejilla--4">
        {l.trabajo.items.map((it, i) => (
          <article class="tarjeta lp-item aparece">
            <span class="lp-num">{String(i + 1).padStart(2, '0')}</span>
            <h3>{it.t}</h3>
            <p set:html={md(it.d)} />
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="seccion seccion--noche">
    <div class="contenedor">
      <div class="cabecera-seccion">
        <span class="eyebrow"><span class="letra">Γ</span>Cómo empezamos</span>
        <h2>{l.pasos.titulo}</h2>
      </div>
      <ol class="lp-pasos">
        {l.pasos.items.map((p, i) => <li class="aparece"><span class="lp-paso-num">{ROMANOS[i]}</span><h3>{p.t}</h3><p set:html={md(p.d)} /></li>)}
      </ol>
      <a class="btn btn--aurora" href="#formulario">{l.formulario.boton} <span class="flecha">→</span></a>
    </div>
  </section>

  {planes.length > 0 && (
    <section class="seccion">
      <div class="contenedor">
        <div class="cabecera-seccion cabecera-seccion--centro">
          <span class="eyebrow"><span class="letra">Δ</span>Planes</span>
          <h2 set:html={l.planes.titulo} />
          <p class="lead">{l.planes.intro}</p>
        </div>
        <div class="lp-planes">
          {planes.map((pl) => (
            <article class:list={['lp-plan aparece', { 'lp-plan--destacado': pl.destacado }]}>
              {pl.destacado && <span class="lp-cinta">{pl.cinta || 'Recomendado'}</span>}
              <h3>{pl.nombre}</h3>
              <p class="lp-precio"><span>{pl.precio}</span> <small>{pl.periodo}</small></p>
              {pl.paraQuien && <p class="lp-para">{pl.paraQuien}</p>}
              <a class:list={['btn', pl.destacado ? 'btn--aurora' : 'btn--tinta']} href="#formulario" data-plan={pl.nombre}>Me interesa <span class="flecha">→</span></a>
            </article>
          ))}
        </div>
        <p class="nota lp-planes-nota"><a href={`/servicios/${pagina.slug}/#planes`}>Ver qué incluye cada plan</a></p>
      </div>
    </section>
  )}

  <section class="seccion seccion--piedra">
    <div class="contenedor">
      <div class="cabecera-seccion">
        <span class="eyebrow"><span class="letra">Ε</span>Nuestro compromiso</span>
        <h2 set:html={l.garantias.titulo} />
      </div>
      <div class="rejilla rejilla--4">
        {l.garantias.items.map((g) => <div class="lp-garantia aparece"><h3>{g.t}</h3><p set:html={md(g.d)} /></div>)}
      </div>
    </div>
  </section>

  <Faq titulo={l.faq.titulo} preguntas={l.faq.preguntas} letra="Ϛ" />

  <section class="banda-cta">
    <div class="contenedor banda-in aparece">
      <span class="eyebrow"><span class="letra">Ζ</span>Diagnóstico gratis</span>
      <h2 set:html={l.cierre.titulo} />
      <p class="lead">{l.cierre.texto}</p>
      <div class="hero-botones" style="justify-content:center">
        <a class="btn btn--aurora" href="#formulario">{l.formulario.boton} <span class="flecha">→</span></a>
        <a class="btn btn--linea btn--claro" href={whatsappUrl()} target="_blank" rel="noopener">WhatsApp {SITIO.whatsappVisible}</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .lp-hero{grid-template-columns:1.05fr 1fr;align-items:start;}
  .lp-hero h1{font-size:clamp(2.6rem,5.4vw,4.6rem);}
  .lp-form{padding:34px;box-shadow:var(--sombra);display:grid;gap:10px;background:var(--papel);}
  .lp-form-titulo{font-family:var(--serif);font-size:2rem;line-height:1.05;}
  .lp-form-sub{color:var(--tinta-2);font-size:.95rem;margin-bottom:8px;}
  @media (max-width:900px){ .lp-hero{grid-template-columns:1fr;} .lp-form{padding:24px;} }

  .lp-dos{display:grid;grid-template-columns:1.1fr 1fr;gap:48px;align-items:center;}
  @media (max-width:900px){ .lp-dos{grid-template-columns:1fr;} }
  .lp-dolores{list-style:none;display:grid;border-top:1px solid var(--linea);}
  .lp-dolores li{display:grid;grid-template-columns:56px 1fr;gap:14px;padding:20px 0;border-bottom:1px solid var(--linea);font-size:1.08rem;}
  .romano{font-family:var(--serif);font-size:1.6rem;line-height:1;color:var(--aurora-ink);}

  .lp-item{display:grid;gap:10px;align-content:start;}
  .lp-item h3{font-size:1.6rem;}
  .lp-item p{color:var(--tinta-2);font-size:.98rem;}
  .lp-num{font-family:var(--mono);font-size:.8rem;color:var(--oro);}

  .lp-pasos{list-style:none;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:28px;margin-bottom:44px;}
  .lp-pasos li{border-top:1px solid rgba(255,255,255,.18);padding-top:22px;display:grid;gap:10px;align-content:start;}
  .lp-pasos h3{font-size:1.8rem;color:#FBF4E8;}
  .lp-pasos p{color:#CFC8BD;}
  .lp-paso-num{font-family:var(--serif);font-size:2.2rem;line-height:1;color:var(--azafran);}
  @media (max-width:760px){ .lp-pasos{grid-template-columns:1fr;} }

  .lp-planes{display:grid;gap:22px;grid-template-columns:repeat(auto-fit,minmax(min(100%,280px),1fr));}
  .lp-plan{position:relative;background:var(--papel);border:1px solid var(--linea);border-radius:22px;padding:30px 28px;display:flex;flex-direction:column;gap:12px;}
  .lp-plan h3{font-size:1.8rem;}
  .lp-precio span{font-family:var(--serif);font-size:2.8rem;line-height:1;font-variant-numeric:lining-nums;}
  .lp-precio small{color:var(--tinta-3);}
  .lp-para{color:var(--tinta-2);font-size:.95rem;flex:1;}
  .lp-plan .btn{align-self:flex-start;}
  .lp-plan--destacado{background:var(--noche);border-color:var(--noche);color:#E8E1D5;box-shadow:0 30px 60px -30px rgba(23,26,54,.6);}
  .lp-plan--destacado h3{color:#FBF4E8;}
  .lp-plan--destacado .lp-para,.lp-plan--destacado .lp-precio small{color:#CFC8BD;}
  .lp-cinta{position:absolute;top:-13px;left:28px;background:var(--azafran);color:var(--tinta);font-family:var(--etiqueta);font-size:.7rem;letter-spacing:.16em;text-transform:uppercase;padding:5px 14px;border-radius:999px;font-weight:700;}
  .lp-planes-nota{text-align:center;margin-top:26px;}

  .lp-garantia{border-top:2px solid var(--aurora);padding-top:18px;display:grid;gap:8px;align-content:start;}
  .lp-garantia h3{font-size:1.5rem;}
  .lp-garantia p{color:var(--tinta-2);font-size:.97rem;}
</style>
