---
// Landing pages de captación: /lp/<slug>/. Datos en src/data/landings.ts.
// noindex: son para campañas; las páginas que posicionan son las de servicio.
//
// Orden: promesa + tres datos + formulario (en móvil el formulario sube a la
// primera pantalla: los datos se repiten en «Qué te llevas») → qué te llevas →
// lo que cuesta → garantías → preguntas → cierre.
import BaseLayout from '../../layouts/BaseLayout.astro';
import AuroraFondo from '../../components/AuroraFondo.astro';
import Formulario from '../../components/Formulario.astro';
import Escena from '../../components/Escena.astro';
import Faq from '../../components/Faq.astro';
import { LANDINGS, type Landing } from '../../data/landings';
import { PAGINAS } from '../../data/paginas';
import { SITIO, whatsappUrl } from '../../data/sitio';
import { md } from '../../lib/texto';
import type { Plan, Extra } from '../../data/tipos';

export function getStaticPaths() {
  return LANDINGS.map((l) => ({ params: { slug: l.slug }, props: { l } }));
}
const { l } = Astro.props as { l: Landing };

const pagina = PAGINAS.find((p) => p.slug === l.servicio);
if (!pagina) throw new Error(`Landing ${l.slug}: el servicio ${l.servicio} no tiene página`);
const planes: Plan[] = pagina.bloques.flatMap((b) => (b.tipo === 'planes' ? b.planes : []));
const extras: Extra[] = pagina.bloques.flatMap((b) => (b.tipo === 'extras' ? b.items : []));
const f = l.formulario;
const enlaces = [
  { href: '#que-te-llevas', texto: 'Qué te llevas' },
  ...(l.areas ? [{ href: '#que-hacemos', texto: 'Qué hacemos' }] : []),
  ...(planes.length ? [{ href: '#precios', texto: 'Precios' }] : []),
  { href: '#preguntas', texto: 'Preguntas' },
];
---
<BaseLayout title={l.title} description={l.description} noindex landing={{ cta: 'Diagnóstico gratis', enlaces }}>
  <section class="hero contenedor lp-hero">
    <AuroraFondo />
    <div class="hero-texto">
      <span class="eyebrow"><span class="letra letra--sin">✦</span>{l.hero.antetitulo}</span>
      <h1 set:html={l.hero.h1} />
      <p class="lead">{l.hero.entrada}</p>
      <ul class="lp-datos">
        {l.hero.datos.map((d) => <li><strong>{d.t}</strong><span>{d.d}</span></li>)}
      </ul>
      <a class="lp-baja" href="#que-te-llevas">Sigue y descubre cómo trabajamos ↓</a>
    </div>
    <div class="tarjeta lp-form" id="formulario">
      <h2 class="lp-form-titulo">{f.titulo}</h2>
      <p class="lp-form-sub">{f.subtitulo}</p>
      <Formulario tipo="landing" servicio={f.servicio} necesidades={f.necesidades} inversiones={f.inversiones} siguientes={f.siguientes} herramientas={f.herramientas} ayudaWeb={f.ayudaWeb} boton={f.boton} />
    </div>
  </section>

  <section class="seccion seccion--piedra" id="que-te-llevas">
    <div class="contenedor">
      <div class="cabecera-seccion">
        <span class="eyebrow"><span class="letra">Α</span>Qué te llevas</span>
        <h2 set:html={l.llevas.titulo} />
        <p class="lead">{l.llevas.intro}</p>
      </div>
      <div class="lp-llevas">
        {l.llevas.items.map((it, i) => (
          <article class="tarjeta lp-item aparece">
            <span class="lp-num">{String(i + 1).padStart(2, '0')}</span>
            <h3>{it.t}</h3>
            <p set:html={md(it.d)} />
          </article>
        ))}
      </div>
    </div>
  </section>

  {l.areas && (
    <section class="seccion" id="que-hacemos">
      <div class="contenedor">
        <div class="cabecera-seccion">
          <span class="eyebrow"><span class="letra letra--sin">✦</span>Qué hacemos</span>
          <h2 set:html={l.areas.titulo} />
          <p class="lead" set:html={md(l.areas.intro)} />
        </div>
        <div class="lp-areas">
          {l.areas.items.map((a, i) => (
            <article class="lp-area aparece">
              <span class="lp-num">{String(i + 1).padStart(2, '0')}</span>
              <h3>{a.t}</h3>
              <p set:html={md(a.d)} />
              <ul class="lp-lista">{a.puntos.map((x) => <li set:html={md(x)} />)}</ul>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  {l.modelo && (
    <section class="seccion seccion--piedra">
      <div class="contenedor">
        <div class="cabecera-seccion cabecera-seccion--centro">
          <span class="eyebrow"><span class="letra letra--sin">✦</span>Modelo de trabajo</span>
          <h2 set:html={l.modelo.titulo} />
          <p class="lead" set:html={md(l.modelo.intro)} />
        </div>
        <ol class="lp-modelo">
          {l.modelo.items.map((m, i) => (
            <li class="aparece"><span class="lp-modelo-n">{i + 1}</span><h3>{m.t}</h3><p set:html={md(m.d)} /></li>
          ))}
        </ol>
      </div>
    </section>
  )}

  {planes.length > 0 && (
    <section class="seccion" id="precios">
      <div class="contenedor">
        <div class="cabecera-seccion cabecera-seccion--centro">
          <span class="eyebrow"><span class="letra">Β</span>Lo que cuesta</span>
          <h2 set:html={l.cuesta.titulo} />
          <p class="lead">{l.cuesta.intro}</p>
        </div>
        <div class="lp-planes">
          {planes.map((pl) => (
            <article class:list={['lp-plan aparece', { 'lp-plan--destacado': pl.destacado }]}>
              {pl.destacado && <span class="lp-cinta">{pl.cinta || 'Recomendado'}</span>}
              <h3>{pl.nombre}</h3>
              <p class="lp-precio"><span>{pl.precio}</span> <small>{pl.periodo}</small></p>
              {pl.paraQuien && <p class="lp-para">{pl.paraQuien}</p>}
              {pl.base && <p class="lp-base">{pl.base}</p>}
              <ul class="lp-lista">{pl.incluye.slice(0, 5).map((x) => <li>{x}</li>)}</ul>
              <a class:list={['btn', pl.destacado ? 'btn--aurora' : 'btn--tinta']} href="#formulario" data-plan={pl.nombre}>Me interesa <span class="flecha">→</span></a>
            </article>
          ))}
        </div>
        {extras.length > 0 && (
          <div class="lp-extras">
            {extras.map((x) => (
              <div class="lp-extra aparece">
                <p class="lp-extra-cab"><strong>{x.nombre}</strong><span>{x.precio}</span></p>
                <p>{x.paraQuien}</p>
                <a href="#formulario" data-plan={x.nombre}>Me interesa →</a>
              </div>
            ))}
          </div>
        )}
        <p class="nota lp-nota">{l.cuesta.nota} <a href={`/servicios/${pagina.slug}/#planes`}>Ver qué incluye cada plan</a>.</p>
      </div>
    </section>
  )}

  <section class="seccion seccion--noche" id="garantias">
    <div class="contenedor">
      <div class="cabecera-seccion">
        <span class="eyebrow"><span class="letra">Γ</span>Garantías</span>
        <h2 set:html={l.garantias.titulo} />
        <p class="lead">{l.garantias.intro}</p>
      </div>
      <div class="lp-garantias">
        {l.garantias.items.map((g) => <div class="lp-garantia aparece"><h3>{g.t}</h3><p set:html={md(g.d)} /></div>)}
      </div>
    </div>
  </section>

  <Faq titulo={l.faq.titulo} preguntas={l.faq.preguntas} letra="Δ" />

  <section class="seccion seccion--piedra">
    <div class="contenedor lp-cierre">
      <div class="aparece">
        <span class="eyebrow"><span class="letra">Ε</span>Contacto</span>
        <h2 set:html={l.cierre.titulo} />
        <p class="lead">{l.cierre.texto}</p>
        <div class="hero-botones">
          <a class="btn btn--aurora" href="#formulario">{f.boton} <span class="flecha">→</span></a>
          <a class="btn btn--linea" href={whatsappUrl()} target="_blank" rel="noopener">WhatsApp {SITIO.whatsappVisible}</a>
        </div>
      </div>
      <Escena nombre={pagina.escena} />
    </div>
  </section>
</BaseLayout>

<style>
  .lp-hero{grid-template-columns:1.05fr minmax(0,.95fr);align-items:start;}
  .lp-hero h1{font-size:clamp(2.6rem,5.2vw,4.6rem);}
  .lp-datos{list-style:none;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));margin-top:10px;border-top:1px solid var(--linea);}
  .lp-datos li{display:grid;gap:2px;padding:16px 16px 0 0;font-size:.9rem;color:var(--tinta-2);}
  .lp-datos li + li{padding-left:16px;border-left:1px solid var(--linea);}
  .lp-datos strong{font-family:var(--serif);font-size:1.45rem;font-weight:400;line-height:1.1;color:var(--tinta);}
  .lp-baja{font-size:.9rem;color:var(--tinta-3);text-decoration:none;margin-top:8px;}
  .lp-baja:hover{color:var(--tinta);}
  .lp-form{padding:30px;box-shadow:var(--sombra);display:grid;gap:8px;background:var(--papel);}
  .lp-form-titulo{font-size:2rem;line-height:1.05;}
  .lp-form-sub{color:var(--tinta-2);font-size:.95rem;margin-bottom:8px;}
  /* Móvil: el formulario en la primera pantalla. Los datos vuelven a salir en «Qué te llevas». */
  @media (max-width:900px){
    .lp-hero{grid-template-columns:1fr;gap:26px;}
    .lp-hero .lead,.lp-datos,.lp-baja{display:none;}
    .lp-form{padding:22px;}
  }

  .lp-llevas{display:grid;gap:18px;grid-template-columns:repeat(auto-fit,minmax(min(100%,250px),1fr));}
  .lp-item{display:grid;gap:10px;align-content:start;background:var(--papel);}
  .lp-item h3{font-size:1.55rem;}
  .lp-item p{color:var(--tinta-2);font-size:.97rem;}
  .lp-num{font-family:var(--mono);font-size:.8rem;color:var(--oro);}

  .lp-planes{display:grid;gap:22px;grid-template-columns:repeat(auto-fit,minmax(min(100%,290px),1fr));align-items:stretch;}
  .lp-plan{position:relative;background:var(--papel);border:1px solid var(--linea);border-radius:22px;padding:30px 28px;display:flex;flex-direction:column;gap:12px;}
  .lp-plan h3{font-size:1.8rem;}
  .lp-precio span{font-family:var(--serif);font-size:2.8rem;line-height:1;font-variant-numeric:lining-nums;}
  .lp-precio small{color:var(--tinta-3);}
  .lp-para{color:var(--tinta-2);font-size:.95rem;}
  .lp-base{font-size:.92rem;font-weight:500;}
  .lp-lista{list-style:none;display:grid;gap:8px;flex:1;align-content:start;margin-bottom:6px;}
  .lp-lista li{position:relative;padding-left:24px;font-size:.93rem;color:var(--tinta-2);}
  .lp-lista li::before{content:"";position:absolute;left:2px;top:.5em;width:11px;height:6px;border-left:2.2px solid var(--aurora);border-bottom:2.2px solid var(--aurora);transform:rotate(-45deg);}
  .lp-plan .btn{align-self:flex-start;}
  .lp-plan--destacado{background:var(--noche);border-color:var(--noche);color:#E8E1D5;box-shadow:0 30px 60px -30px rgba(23,26,54,.6);}
  .lp-plan--destacado h3,.lp-plan--destacado .lp-base{color:#FBF4E8;}
  .lp-plan--destacado .lp-para,.lp-plan--destacado .lp-precio small,.lp-plan--destacado .lp-lista li{color:#CFC8BD;}
  .lp-plan--destacado .lp-lista li::before{border-color:var(--azafran);}
  .lp-cinta{position:absolute;top:-13px;left:28px;background:var(--azafran);color:var(--tinta);font-family:var(--etiqueta);font-size:.7rem;letter-spacing:.16em;text-transform:uppercase;padding:5px 14px;border-radius:999px;font-weight:700;}
  .lp-extras{display:grid;gap:18px;grid-template-columns:repeat(auto-fit,minmax(min(100%,300px),1fr));margin-top:22px;}
  .lp-extra{border:1px dashed var(--linea-2);border-radius:18px;padding:20px 22px;display:grid;gap:8px;font-size:.95rem;color:var(--tinta-2);}
  .lp-extra-cab{display:grid;gap:4px;}
  .lp-extra-cab strong{font-family:var(--serif);font-weight:400;font-size:1.45rem;color:var(--tinta);}
  .lp-extra-cab span{font-family:var(--mono);font-size:.9rem;color:var(--aurora-ink);}
  .lp-extra a{font-weight:500;text-decoration:none;}
  .lp-nota{text-align:center;margin:28px auto 0;max-width:72ch;}

  .lp-garantias{display:grid;gap:28px;grid-template-columns:repeat(auto-fit,minmax(min(100%,240px),1fr));}
  .lp-garantia{border-top:1px solid rgba(255,255,255,.2);padding-top:20px;display:grid;gap:8px;align-content:start;}
  .lp-garantia h3{font-size:1.6rem;color:#FBF4E8;}
  .lp-garantia p{color:#CFC8BD;font-size:.97rem;}
  .lp-garantia :global(a){color:var(--azafran);}

  .lp-areas{display:grid;gap:18px;grid-template-columns:repeat(auto-fit,minmax(min(100%,460px),1fr));}
  .lp-area{border:1px solid var(--linea);border-radius:var(--radio);background:var(--papel);padding:30px;display:grid;gap:12px;align-content:start;}
  .lp-area h3{font-size:1.8rem;}
  .lp-area > p{color:var(--tinta-2);}

  .lp-modelo{list-style:none;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:0;counter-reset:m;}
  .lp-modelo li{position:relative;padding:0 22px;display:grid;gap:10px;align-content:start;text-align:center;justify-items:center;}
  .lp-modelo li + li::before{content:"";position:absolute;top:26px;left:-50%;width:100%;height:1px;background:linear-gradient(90deg,transparent,var(--aurora),transparent);z-index:0;}
  .lp-modelo-n{position:relative;z-index:1;width:52px;height:52px;border-radius:50%;display:grid;place-items:center;background:var(--papel);border:1px solid var(--aurora);font-family:var(--serif);font-size:1.5rem;color:var(--aurora-ink);}
  .lp-modelo h3{font-size:1.5rem;}
  .lp-modelo p{color:var(--tinta-2);font-size:.95rem;}
  @media (max-width:900px){ .lp-modelo{grid-template-columns:1fr 1fr;row-gap:32px;} .lp-modelo li::before{display:none;} }
  @media (max-width:520px){ .lp-modelo{grid-template-columns:1fr;} }

  .lp-cierre{display:grid;grid-template-columns:1.1fr 1fr;gap:48px;align-items:center;}
  .lp-cierre > div{display:grid;gap:20px;}
  @media (max-width:900px){ .lp-cierre{grid-template-columns:1fr;} }
</style>
