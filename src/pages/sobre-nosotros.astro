---
import BaseLayout from '../layouts/BaseLayout.astro';
import AuroraFondo from '../components/AuroraFondo.astro';
import Personas from '../components/Personas.astro';
import Experiencia from '../components/Experiencia.astro';
import { SITIO } from '../data/sitio';
import { EQUIPO, EQUIPO_ANONIMO } from '../data/equipo';
import { BASE_URL } from '../lib/seo';

const principios = [
  { t: 'Trato directo', d: 'Una persona de referencia que conoce tu negocio y te acompaña en todo el proyecto, sin intermediarios.' },
  { t: 'Alcance definido', d: 'Tareas, entregables y condiciones económicas, por escrito antes de empezar.' },
  { t: 'Costes separados', d: 'Nuestros honorarios, por un lado; licencias y costes de terceros, por otro.' },
  { t: 'Informes que se entienden', d: 'Qué ha pasado, por qué y qué haremos a continuación.' },
  { t: 'Honestidad', d: 'No prometemos posiciones imposibles. Trabajamos para crecer de forma sostenible.' },
  { t: 'Tus sistemas, bajo tu control', d: 'Cuentas, datos y accesos a tu nombre, conforme a lo acordado.' },
];

const historia = [
  { t: 'Coincidimos trabajando', d: 'Nos conocimos como compañeros de trabajo, en el día a día de equipos de marketing de grandes marcas.' },
  { t: 'Pasamos por muchos departamentos', d: 'SEO, captación, contenidos, email, automatización, datos y gestión de proyectos. Vimos cómo encajan las piezas, y dónde suelen romperse.' },
  { t: 'Y por muchas marcas', d: 'Sectores y tamaños distintos, y una misma conclusión: lo que funciona es el método, no el presupuesto. Y casi nunca llega a las empresas pequeñas.' },
  { t: 'Decidimos crear EOS Studio', d: 'Un servicio con esa forma de trabajar al alcance de cualquier negocio: sencillo, claro, sin letra pequeña y con la calidad de los grandes.' },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: `Sobre ${SITIO.nombre}`,
  url: `${BASE_URL}/sobre-nosotros/`,
  mainEntity: EQUIPO_ANONIMO ? { '@id': `${BASE_URL}/#organization` } : EQUIPO.map((p) => ({
    '@type': 'Person', name: p.nombre, jobTitle: p.cargo, email: p.email, url: p.linkedin, sameAs: [p.linkedin],
    worksFor: { '@id': `${BASE_URL}/#organization` },
    hasCredential: p.certificaciones.map((c) => ({ '@type': 'EducationalOccupationalCredential', name: c.nombre, recognizedBy: { '@type': 'Organization', name: c.emisor } })),
    address: { '@type': 'PostalAddress', addressLocality: p.sede, addressCountry: 'ES' },
  })),
};
---
<BaseLayout
  title="Sobre nosotros: la historia de EOS Studio | A Coruña y Valencia"
  description="EOS Studio nace de dos compañeros de trabajo que, tras años en distintos departamentos y marcas, crearon otra forma de hacer SEO, GEO y marketing."
  schema={schema}
>
  <section class="hero contenedor hero--simple">
    <AuroraFondo />
    <div class="hero-texto">
      <span class="eyebrow"><span class="letra letra--sin">✦</span>Sobre nosotros · {SITIO.sedes.join(' · ')}</span>
      <h1>Dos compañeros de trabajo, <em>una forma nueva de trabajar</em></h1>
      <p class="lead">EOS Studio nace de dos compañeros que trabajaron juntos durante años, pasaron por varios departamentos y marcas, y decidieron unir lo aprendido en un servicio propio: marketing ordenado, claro y sin letra pequeña.</p>
    </div>
  </section>

  <section class="seccion seccion--sin-arriba">
    <div class="contenedor historia">
      <div class="cabecera-seccion">
        <span class="eyebrow"><span class="letra letra--sin">✦</span>Nuestra historia</span>
        <h2>De compartir equipo <em>a crear el nuestro</em></h2>
      </div>
      <ol class="historia-pasos">
        {historia.map((h, i) => <li class="aparece"><span class="historia-n">{['I', 'II', 'III', 'IV'][i]}</span><h3>{h.t}</h3><p>{h.d}</p></li>)}
      </ol>
    </div>
  </section>

  <section class="seccion seccion--piedra">
    <div class="contenedor">
      <div class="cabecera-seccion">
        <span class="eyebrow"><span class="letra letra--sin">✦</span>Dos perfiles</span>
        <h2>Dos perfiles <em>que se completan</em></h2>
        <p class="lead">Uno se ocupa de que te encuentren; el otro, de que cada contacto tenga seguimiento y cada proyecto llegue a término. Coordinan cada trabajo y suman a los especialistas que tu negocio necesita.</p>
      </div>
      <Personas />
    </div>
  </section>

  <section class="seccion">
    <div class="contenedor">
      <Experiencia />
    </div>
  </section>

  <section class="seccion seccion--piedra">
    <div class="contenedor">
      <div class="cabecera-seccion">
        <span class="eyebrow"><span class="letra">Α</span>Cómo trabajamos</span>
        <h2>Lo que puedes <em>esperar de nosotros</em></h2>
      </div>
      <ul class="principios">
        {principios.map((p) => <li class="aparece"><h3>{p.t}</h3><p>{p.d}</p></li>)}
      </ul>
    </div>
  </section>

  <section class="banda-cta">
    <div class="contenedor banda-in aparece">
      <span class="eyebrow"><span class="letra">Β</span>Hablemos</span>
      <h2>¿Empezamos por <em>tu amanecer</em>?</h2>
      <p class="lead">Cuéntanos qué haces y qué quieres conseguir. Te respondemos con un primer diagnóstico y una propuesta de por dónde empezar.</p>
      <div class="hero-botones" style="justify-content:center">
        <a class="btn btn--aurora" href="/contacto/">Contactar <span class="flecha">→</span></a>
        <a class="btn btn--linea btn--claro" href="/diagnostico/">Pedir diagnóstico gratuito</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .historia-pasos{list-style:none;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:28px;}
  .historia-pasos li{border-top:1px solid var(--linea-2);padding-top:20px;display:grid;gap:10px;align-content:start;}
  .historia-n{font-family:var(--serif);font-size:2rem;line-height:1;color:var(--aurora-ink);}
  .historia-pasos h3{font-size:1.6rem;}
  .historia-pasos p{color:var(--tinta-2);font-size:.98rem;}
  @media (max-width:900px){ .historia-pasos{grid-template-columns:1fr 1fr;} }
  @media (max-width:560px){ .historia-pasos{grid-template-columns:1fr;} }
  .principios{list-style:none;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:0 32px;}
  .principios li{border-top:1px solid var(--linea-2);padding:20px 0 26px;}
  .principios h3{font-size:1.6rem;margin-bottom:6px;}
  .principios p{color:var(--tinta-2);font-size:.98rem;}
  @media (max-width:900px){ .principios{grid-template-columns:1fr 1fr;} }
  @media (max-width:560px){ .principios{grid-template-columns:1fr;} }
</style>
