---
import BaseLayout from '../layouts/BaseLayout.astro';
import Escena from '../components/Escena.astro';
import AuroraFondo from '../components/AuroraFondo.astro';
import Cinta from '../components/Cinta.astro';
import Faq from '../components/Faq.astro';
import TarjetasServicios from '../components/TarjetasServicios.astro';
import { SERVICIOS, CATEGORIAS, type Categoria } from '../data/servicios';
import { SITIO } from '../data/sitio';

const grupos = (Object.keys(CATEGORIAS) as Categoria[]).map((c) => ({ ...CATEGORIAS[c], servicios: SERVICIOS.filter((s) => s.categoria === c) }));
const mailto = `mailto:${SITIO.email}?subject=${encodeURIComponent('Quiero hablar de mi proyecto')}`;

const metodo = [
  { t: 'Entendemos tu negocio', d: 'Qué vendes, a quién, dónde y qué quieres conseguir. Sin ese punto de partida, cualquier acción es una apuesta.' },
  { t: 'Analizamos el punto de partida', d: 'Tu web, tus fichas, tus canales, tus datos y tu competencia. Vemos qué conservar y dónde están las oportunidades.' },
  { t: 'Priorizamos las acciones', d: 'Te proponemos acciones concretas, con alcance y entregables definidos. Tú decides qué contratar.' },
  { t: 'Medimos y ajustamos', d: 'Revisamos los resultados contigo y ajustamos las siguientes prioridades según los datos y tus objetivos.' },
];

const principios = [
  { t: 'Trato directo', d: 'Hablas siempre con quien trabaja en tu proyecto, sin intermediarios.' },
  { t: 'Alcance definido', d: 'Tareas, entregables y condiciones económicas, por escrito antes de empezar.' },
  { t: 'Costes separados', d: 'Nuestros honorarios, por un lado; licencias y costes de terceros, por otro.' },
  { t: 'Informes que se entienden', d: 'Qué ha pasado, por qué y qué haremos a continuación.' },
  { t: 'Honestidad', d: 'No prometemos posiciones imposibles. Trabajamos para crecer de forma sostenible.' },
  { t: 'Tus sistemas, bajo tu control', d: 'Cuentas, datos y accesos a tu nombre, conforme a lo acordado.' },
];

const preguntas = [
  { p: '¿Qué es el GEO?', r: 'GEO (Generative Engine Optimization) es el trabajo para que los asistentes y buscadores de IA, como ChatGPT, Gemini, Perplexity o las respuestas con IA de Google, entiendan tu marca, la citen y la recomienden. Se apoya en el SEO de siempre y le suma contenido experto, datos estructurados y menciones en fuentes de confianza.' },
  { p: '¿Qué diferencia hay entre SEO y GEO?', r: 'El SEO busca que tu web aparezca en los resultados de los buscadores. El GEO busca que tu marca aparezca dentro de las respuestas que redacta una IA. No compiten: una web bien posicionada y con autoridad es la base de las dos.' },
  { p: '¿Trabajáis solo con empresas de Valencia?', r: 'Estamos en Valencia y el SEO local lo centramos en Valencia y alrededores. El resto de servicios se presta en remoto para empresas de toda España.' },
  { p: '¿Por dónde empiezo?', r: 'Cuéntanos qué haces, qué quieres conseguir y qué herramientas usas. Revisamos tu punto de partida y te proponemos por dónde empezar, con alcance y precio cerrados antes de comprometerte a nada.' },
];
---
<BaseLayout
  title="EOS Studio · Agencia de SEO, GEO y marketing digital en Valencia"
  description={SITIO.descripcion}
>
  <section class="hero contenedor">
    <AuroraFondo />
    <div class="hero-texto">
      <span class="eyebrow"><span class="letra">✦</span>Agencia de marketing digital · Valencia</span>
      <h1>Que tu marca <em>amanezca</em> en Google y en la IA</h1>
      <p class="lead">Somos EOS Studio, una agencia de marketing digital en Valencia. Posicionamos tu negocio en buscadores y en asistentes de IA, construimos su autoridad y conectamos marketing y ventas para que cada visita tenga un siguiente paso.</p>
      <div class="hero-botones">
        <a class="btn btn--aurora" href={mailto}>Cuéntanos tu proyecto <span class="flecha">→</span></a>
        <a class="btn btn--linea" href="/servicios/">Ver servicios</a>
      </div>
    </div>
    <Escena nombre="hero" class="hero-escena" />
  </section>

  <Cinta items={['SEO local', 'GEO', 'SEO para YouTube', 'Autoridad digital', 'Digital PR', 'Marketing automation', 'Consultoría CRM', 'Marketing de contenidos']} />

  <section class="mito seccion--noche">
    <div class="mito-horizonte" aria-hidden="true"></div>
    <div class="contenedor mito-in aparece">
      <span class="eyebrow"><span class="letra">✦</span>El mito</span>
      <p class="mito-cita">«Cada mañana, Eos, la de dedos rosados, abría las puertas del cielo para que entrara <em>la luz</em>.»</p>
      <p class="mito-texto">Nuestro oficio se le parece: que tu marca sea lo primero que ve quien busca. En Google, en Maps, en YouTube y en las respuestas de la inteligencia artificial. La historia nos da el nombre; lo digital, las herramientas.</p>
    </div>
  </section>

  <section class="seccion" id="servicios">
    <div class="contenedor">
      <div class="cabecera-seccion">
        <span class="eyebrow"><span class="letra">Α</span>Servicios</span>
        <h2>Tres frentes, <em>una sola estrategia</em></h2>
        <p class="lead">Que te encuentren, que confíen en ti y que cada contacto llegue a cliente. Trabajamos los tres a la vez o empezamos por el que más te urja.</p>
      </div>
      {grupos.map((g) => (
        <div class="grupo">
          <div class="grupo-cab">
            <span class="grupo-letra">{g.letra}</span>
            <div><h3>{g.nombre}</h3><p>{g.descripcion}</p></div>
          </div>
          <TarjetasServicios servicios={g.servicios} />
        </div>
      ))}
    </div>
  </section>

  <section class="seccion seccion--noche" id="metodo">
    <div class="contenedor">
      <div class="cabecera-seccion">
        <span class="eyebrow"><span class="letra">Β</span>Método</span>
        <h2>De la situación actual a <em>un plan claro</em></h2>
      </div>
      <ol class="pasos">
        {metodo.map((p, i) => <li class="aparece"><span class="paso-num">{['I', 'II', 'III', 'IV'][i]}</span><h3>{p.t}</h3><p>{p.d}</p></li>)}
      </ol>
    </div>
  </section>

  <section class="seccion" id="equipo">
    <div class="contenedor equipo">
      <div class="cabecera-seccion">
        <span class="eyebrow"><span class="letra">Γ</span>Equipo</span>
        <h2>Un estudio pequeño, <em>a propósito</em></h2>
        <p class="lead">Somos dos personas con un método. Sin cuentas que pasan de mano en mano ni informes que nadie entiende: quien te escucha el primer día es quien trabaja en tu proyecto.</p>
        <a class="btn btn--tinta" href={mailto}>Conócenos <span class="flecha">→</span></a>
      </div>
      <ul class="principios">
        {principios.map((p) => <li class="aparece"><h3>{p.t}</h3><p>{p.d}</p></li>)}
      </ul>
    </div>
  </section>

  <Faq titulo="Lo que más nos preguntan" preguntas={preguntas} letra="Δ" />

  <section class="banda-cta">
    <div class="contenedor banda-in aparece">
      <span class="eyebrow"><span class="letra">Ε</span>Hablemos</span>
      <h2>¿Empezamos por <em>tu amanecer</em>?</h2>
      <p class="lead">Cuéntanos qué haces y qué quieres conseguir. Te respondemos con un primer diagnóstico y una propuesta de por dónde empezar.</p>
      <a class="btn btn--aurora" href={mailto}>{SITIO.email} <span class="flecha">→</span></a>
    </div>
  </section>
</BaseLayout>

<style>
  .mito{position:relative;padding:clamp(96px,13vw,170px) 0 clamp(120px,15vw,200px);}
  .mito-in{display:grid;gap:26px;justify-items:center;text-align:center;}
  .mito-cita{font-family:var(--serif);font-size:clamp(2rem,4.4vw,3.6rem);line-height:1.08;max-width:24ch;color:#FFFFFF !important;letter-spacing:-.01em;}
  .mito-cita em{background:var(--degradado);-webkit-background-clip:text;background-clip:text;color:transparent;}
  .mito-texto{max-width:58ch;}
  /* El horizonte: una línea fina con el sol asomando, abajo de la banda. */
  .mito-horizonte{position:absolute;left:0;right:0;bottom:0;height:46%;pointer-events:none;background:radial-gradient(38% 70% at 50% 100%,rgba(240,122,69,.55),rgba(231,169,58,.18) 45%,transparent 70%);}
  .mito-horizonte::after{content:"";position:absolute;left:8%;right:8%;bottom:22%;height:1px;background:linear-gradient(90deg,transparent,rgba(255,255,255,.45),transparent);}

  .grupo{margin-top:48px;}
  .grupo-cab{display:flex;gap:18px;align-items:baseline;margin-bottom:22px;border-bottom:1px solid var(--linea);padding-bottom:14px;}
  .grupo-letra{font-family:var(--serif);font-size:3rem;line-height:1;background:var(--degradado);-webkit-background-clip:text;background-clip:text;color:transparent;}
  .grupo-cab h3{font-size:2rem;}
  .grupo-cab p{color:var(--tinta-2);}


  .equipo{display:grid;grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr);gap:56px;align-items:start;}
  .equipo .cabecera-seccion{margin:0;justify-items:start;}
  .principios{list-style:none;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0 32px;}
  .principios li{border-top:1px solid var(--linea-2);padding:20px 0 24px;}
  .principios h3{font-size:1.6rem;margin-bottom:6px;}
  .principios p{color:var(--tinta-2);font-size:.98rem;}
  @media (max-width:900px){ .equipo{grid-template-columns:1fr;gap:28px;} }
  @media (max-width:560px){ .principios{grid-template-columns:1fr;} }

</style>
