---
import { CATEGORIAS, urlServicio, type Servicio } from '../data/servicios';
export interface Props { servicios: Servicio[] }
const { servicios } = Astro.props;
---
<ul class="tarjetas">
  {servicios.map((s) => (
    <li class:list={['ts aparece', { 'ts--pronto': !s.publicado }]}>
      {s.publicado
        ? <a href={urlServicio(s.slug)} class="ts-in">
            <span class="ts-cat">{CATEGORIAS[s.categoria].letra} · {CATEGORIAS[s.categoria].nombre}</span>
            <h3>{s.nombre}</h3>
            <p>{s.resumen}</p>
            <span class="ts-ir">Ver servicio <span aria-hidden="true">→</span></span>
          </a>
        : <div class="ts-in">
            <span class="ts-cat">{CATEGORIAS[s.categoria].letra} · {CATEGORIAS[s.categoria].nombre}</span>
            <h3>{s.nombre}</h3>
            <p>{s.resumen}</p>
            <span class="ts-ir ts-ir--pronto">Próximamente</span>
          </div>}
    </li>
  ))}
</ul>
<style>
  .tarjetas{list-style:none;display:grid;gap:20px;grid-template-columns:repeat(auto-fill,minmax(min(100%,300px),1fr));}
  .ts-in{position:relative;overflow:hidden;height:100%;display:flex;flex-direction:column;gap:10px;background:rgba(255,255,255,.7);backdrop-filter:blur(10px);border:1px solid var(--linea);border-radius:var(--radio);padding:28px;text-decoration:none;color:var(--tinta);transition:transform .3s,box-shadow .3s,border-color .3s;}
  /* Al pasar por encima, amanece: un brillo de aurora sube desde abajo. */
  .ts-in::after{content:"";position:absolute;left:-10%;right:-10%;bottom:-70%;height:90%;border-radius:50%;background:radial-gradient(closest-side,rgba(240,122,69,.28),rgba(231,169,58,.12),transparent);opacity:0;transform:translateY(30%);transition:opacity .45s,transform .45s;pointer-events:none;}
  a.ts-in:hover{transform:translateY(-4px);box-shadow:var(--sombra);border-color:var(--linea-2);color:var(--tinta);}
  a.ts-in:hover::after{opacity:1;transform:none;}
  .ts-cat{font-family:var(--etiqueta);font-size:.68rem;letter-spacing:.16em;text-transform:uppercase;color:var(--tinta-3);}
  .ts-in h3{font-size:1.9rem;}
  .ts-in p{color:var(--tinta-2);font-size:.98rem;flex:1;}
  .ts-ir{font-weight:500;color:var(--tinta);display:inline-flex;align-items:center;gap:10px;}
  .ts-ir span{display:inline-grid;place-items:center;width:30px;height:30px;border-radius:50%;background:var(--degradado);color:var(--tinta);transition:transform .3s;}
  a.ts-in:hover .ts-ir span{transform:rotate(-45deg);}
  .ts-ir--pronto{font-family:var(--mono);font-size:.82rem;color:var(--tinta-3);}
  .ts--pronto .ts-in{background:transparent;backdrop-filter:none;border-style:dashed;}
  .ts-ir--pronto{display:inline-block;}
</style>
