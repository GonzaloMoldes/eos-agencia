---
// Marco de la aurora: piezas fijas en los bordes de la ventana, en todas las
// páginas. Mezclan lo clásico, lo digital y la idea del renacer:
//  - una columna rota de la que salen pistas de circuito (historia → digital)
//    y cuyos fragmentos flotan hacia arriba;
//  - una rama de laurel cuyas hojas de arriba se deshacen en píxeles;
//  - una pluma de fénix, el renacer;
//  - el sol de Eos saliendo por la esquina, con el borde pixelado;
//  - un cursor que hace clic y una greca en la esquina.
//
// Igual que el marco de taller de gmvsolutions:
//  - pointer-events:none y aria-hidden: no se puede pulsar ni lo lee un
//    lector de pantalla;
//  - las piezas quedan cortadas por la ventana y ocupan ~60 px de cada borde;
//  - por debajo de 1280 px solo quedan el sol y la greca, y en móvil nada;
//    no se imprime;
//  - va por encima del contenido (z 50) pero por debajo de la cabecera (100).
---
<div class="marco" aria-hidden="true">
  <!-- Columna rota con pistas de circuito (izquierda, arriba) -->
  <svg class="m-pieza m-columna" viewBox="0 0 120 330" width="120" height="330">
    <g class="m-flota" style="--d:0s"><path d="M10 34l14-8 8 10-6 12-14 2z" fill="#FFFFFF"/><path d="M24 26l8 10-6 12z" fill="#E6E0EE"/></g>
    <g class="m-flota" style="--d:-2s"><path d="M34 8l10 2 2 10-9 4-6-7z" fill="#FFFFFF"/></g>
    <path d="M0 86L10 74L18 82L30 66L40 78L56 64V330H0Z" fill="#FFFFFF"/>
    <path d="M30 66L40 78L56 64V330H28Z" fill="#E6E0EE"/>
    <path d="M12 92V330M26 86V330M42 84V330" stroke="#D6CFE2" stroke-width="2.4"/>
    <g fill="none" stroke="#F07A45" stroke-width="2.4" stroke-linejoin="round" stroke-linecap="round">
      <path d="M56 130H80V102H104"/><path d="M56 176H94V156"/><path d="M56 226H76V256H102"/>
    </g>
    <g fill="#E7A93A"><circle class="m-pulso" style="--d:0s" cx="106" cy="102" r="4.5"/><circle class="m-pulso" style="--d:.8s" cx="94" cy="152" r="4.5"/><circle class="m-pulso" style="--d:1.6s" cx="104" cy="256" r="4.5"/></g>
  </svg>

  <!-- Cursor que hace clic (izquierda, abajo) -->
  <svg class="m-pieza m-cursor" viewBox="0 0 80 80" width="80" height="80">
    <circle class="m-onda" cx="24" cy="24" r="14" fill="none" stroke="#F07A45" stroke-width="2"/>
    <circle cx="24" cy="24" r="6" fill="none" stroke="#F07A45" stroke-width="2" opacity=".6"/>
    <path d="M24 24L24 62L34 52L42 68L49 65L41 49L56 49Z" fill="#141833"/>
  </svg>

  <!-- Sol de Eos saliendo por la esquina, con el borde pixelado (abajo a la izquierda) -->
  <svg class="m-pieza m-sol" viewBox="0 0 200 200" width="200" height="200">
    <circle cx="0" cy="200" r="150" fill="#E7A93A" opacity=".18"/>
    <circle cx="0" cy="200" r="112" fill="#F2A06A" opacity=".45"/>
    <circle cx="0" cy="200" r="76" fill="#F07A45"/>
    <g fill="#F07A45">
      <rect class="m-brilla" style="--d:0s" x="78" y="104" width="10" height="10"/>
      <rect class="m-brilla" style="--d:.6s" x="96" y="124" width="8" height="8"/>
      <rect class="m-brilla" style="--d:1.2s" x="58" y="84" width="8" height="8"/>
    </g>
    <g fill="#E7A93A">
      <rect class="m-brilla" style="--d:.3s" x="120" y="96" width="9" height="9"/>
      <rect class="m-brilla" style="--d:1s" x="104" y="74" width="7" height="7"/>
      <rect class="m-brilla" style="--d:1.7s" x="140" y="130" width="6" height="6"/>
      <rect class="m-brilla" style="--d:2.2s" x="80" y="56" width="6" height="6"/>
    </g>
  </svg>

  <!-- Laurel que se deshace en píxeles (derecha, arriba) -->
  <svg class="m-pieza m-laurel" viewBox="0 0 100 300" width="100" height="300">
    <path d="M78 300C70 230 50 170 52 70" fill="none" stroke="#6F7B3F" stroke-width="3" stroke-linecap="round"/>
    <g fill="#8A9A4B">
      <ellipse cx="58" cy="270" rx="7" ry="15" transform="rotate(-40 58 270)"/><ellipse cx="86" cy="250" rx="7" ry="15" transform="rotate(40 86 250)"/>
      <ellipse cx="46" cy="226" rx="7" ry="15" transform="rotate(-40 46 226)"/><ellipse cx="76" cy="206" rx="7" ry="15" transform="rotate(40 76 206)"/>
      <ellipse cx="38" cy="182" rx="6.5" ry="14" transform="rotate(-40 38 182)"/><ellipse cx="68" cy="162" rx="6.5" ry="14" transform="rotate(40 68 162)"/>
      <ellipse cx="38" cy="138" rx="6" ry="12" transform="rotate(-40 38 138)"/>
    </g>
    <g fill="#6F7B3F"><ellipse cx="64" cy="120" rx="5.5" ry="11" transform="rotate(40 64 120)"/></g>
    <g>
      <rect class="m-brilla" style="--d:0s" x="40" y="96" width="9" height="9" fill="#8A9A4B"/>
      <rect class="m-brilla" style="--d:.7s" x="60" y="84" width="8" height="8" fill="#E7A93A"/>
      <rect class="m-brilla" style="--d:1.4s" x="46" y="66" width="7" height="7" fill="#8A9A4B"/>
      <rect class="m-brilla" style="--d:.4s" x="66" y="52" width="6" height="6" fill="#F07A45"/>
      <rect class="m-brilla" style="--d:1.9s" x="44" y="38" width="6" height="6" fill="#E7A93A"/>
      <rect class="m-brilla" style="--d:1.1s" x="60" y="20" width="5" height="5" fill="#8A9A4B"/>
      <rect class="m-brilla" style="--d:2.4s" x="48" y="6" width="4" height="4" fill="#F07A45"/>
    </g>
  </svg>

  <!-- Pluma de fénix, el renacer (derecha, abajo) -->
  <svg class="m-pieza m-pluma" viewBox="0 0 100 270" width="100" height="270">
    <defs>
      <linearGradient id="marco-pluma" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#E7A93A"/><stop offset=".55" stop-color="#F07A45"/><stop offset="1" stop-color="#B9A7EC"/>
      </linearGradient>
    </defs>
    <g class="m-balanceo">
      <path d="M50 40C88 70 90 170 50 236C12 170 14 70 50 40Z" fill="url(#marco-pluma)"/>
      <path d="M50 40C88 70 90 170 50 236Z" fill="#000" opacity=".07"/>
      <g stroke="#FFFFFF" stroke-opacity=".45" stroke-width="1.6" fill="none">
        <path d="M50 90L28 70M50 120L24 98M50 150L24 130M50 180L28 162M50 90L72 70M50 120L76 98M50 150L76 130M50 180L72 162"/>
      </g>
      <path d="M50 40V264" stroke="#141833" stroke-opacity=".55" stroke-width="2.2" stroke-linecap="round"/>
    </g>
    <rect class="m-brilla" style="--d:0s" x="46" y="22" width="8" height="8" fill="#E7A93A"/>
    <rect class="m-brilla" style="--d:.9s" x="58" y="8" width="6" height="6" fill="#F07A45"/>
    <rect class="m-brilla" style="--d:1.6s" x="36" y="4" width="5" height="5" fill="#E7A93A"/>
  </svg>

  <!-- Greca en la esquina (abajo a la derecha) -->
  <svg class="m-pieza m-greca" viewBox="0 0 72 72" width="72" height="72">
    <path d="M68 8H8V68M20 68V20H56V48H34V34H44" fill="none" stroke="#F07A45" stroke-opacity=".55" stroke-width="2"/>
  </svg>
</div>

<style>
  .marco{position:fixed;inset:0;z-index:50;pointer-events:none;overflow:hidden;}
  .m-pieza{position:absolute;}
  .m-columna{left:-44px;top:150px;}
  .m-cursor{left:6px;top:62%;}
  .m-sol{left:-40px;bottom:-40px;}
  .m-laurel{right:-40px;top:130px;}
  .m-pluma{right:-42px;bottom:12%;transform:rotate(-18deg);}
  .m-greca{right:10px;bottom:10px;}

  @media (prefers-reduced-motion: no-preference){
    .m-flota{animation:mFlota 6s ease-in-out infinite;animation-delay:var(--d);}
    .m-pulso,.m-brilla{animation:mBrilla 2.8s ease-in-out infinite;animation-delay:var(--d);}
    .m-onda{transform-box:fill-box;transform-origin:center;animation:mOnda 2.4s ease-out infinite;}
    .m-balanceo{transform-box:fill-box;transform-origin:50% 100%;animation:mBalanceo 7s ease-in-out infinite;}
  }
  @keyframes mFlota{0%,100%{transform:translateY(0)}50%{transform:translateY(-8px)}}
  @keyframes mBrilla{0%,100%{opacity:1}50%{opacity:.25}}
  @keyframes mOnda{0%{transform:scale(.6);opacity:.9}100%{transform:scale(1.6);opacity:0}}
  @keyframes mBalanceo{0%,100%{transform:rotate(-3deg)}50%{transform:rotate(3deg)}}

  /* Entre 900 y 1280 px no hay hueco a los lados: solo el sol y la greca. */
  @media (max-width:1279px){ .m-columna,.m-cursor,.m-laurel,.m-pluma{display:none;} }
  @media (max-width:900px){ .marco{display:none;} }
  @media print{ .marco{display:none;} }
</style>
