---
// Marco del mito de Eos: piezas fijas en los bordes de la ventana, en todas
// las páginas. Cada una sale de la historia de la diosa y lleva un guiño digital:
//  - la rueda del carro con el que cruza el cielo (Lampo y Faetón tiran de él),
//    con nodos en la punta de los radios;
//  - los «dedos rosados»: rayos que nacen de la esquina, con el sol asomando
//    y el borde pixelado;
//  - un ala, porque en los vasos griegos se la pinta alada;
//  - Eósforo, la estrella de la mañana, hija suya;
//  - el rocío: las lágrimas por su hijo Memnón, que caen despacio;
//  - la cigarra en la que se convirtió Titono, su amante inmortal.
//
// Igual que el marco de taller de gmvsolutions:
//  - pointer-events:none y aria-hidden: no se puede pulsar ni lo lee un
//    lector de pantalla;
//  - las piezas quedan cortadas por la ventana y ocupan ~60 px de cada borde;
//  - por debajo de 1280 px solo quedan los rayos y la cigarra, y en móvil
//    nada; no se imprime;
//  - va por encima del contenido (z 50) pero por debajo de la cabecera (100).
---
<div class="marco" aria-hidden="true">
  <!-- Rueda del carro (izquierda, arriba) -->
  <svg class="m-pieza m-rueda" viewBox="0 0 160 160" width="160" height="160">
    <g class="m-gira">
      <circle cx="80" cy="80" r="62" fill="none" stroke="#C8643B" stroke-width="7"/>
      <circle cx="80" cy="80" r="54" fill="none" stroke="#C8643B" stroke-width="1.6" stroke-dasharray="3 5"/>
      <g stroke="#C8643B" stroke-width="3.4" stroke-linecap="round">
        <path d="M80 18V142M18 80H142M36 36L124 124M124 36L36 124"/>
      </g>
      <circle cx="80" cy="80" r="13" fill="#E8A33D"/><circle cx="80" cy="80" r="5" fill="#1B1412"/>
      <g fill="#E8A33D">
        <circle cx="80" cy="18" r="4.5"/><circle cx="142" cy="80" r="4.5"/><circle cx="80" cy="142" r="4.5"/><circle cx="18" cy="80" r="4.5"/>
      </g>
    </g>
  </svg>

  <!-- Ala (izquierda, abajo) -->
  <svg class="m-pieza m-ala" viewBox="0 0 120 150" width="120" height="150">
    <defs>
      <linearGradient id="marco-ala" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#E98C83"/><stop offset=".6" stop-color="#F07A45"/><stop offset="1" stop-color="#E8A33D"/>
      </linearGradient>
    </defs>
    <g class="m-aletea">
      <path d="M8 20C50 8 96 22 112 52C84 44 60 46 40 54C66 56 86 66 98 84C74 78 54 80 36 88C56 94 70 106 78 124C58 114 38 112 20 116C14 84 6 52 8 20Z" fill="url(#marco-ala)"/>
      <path d="M8 20C30 30 36 70 20 116" fill="none" stroke="#FFFFFF" stroke-opacity=".45" stroke-width="2"/>
      <path d="M40 54L12 50M36 88L14 82" stroke="#FFFFFF" stroke-opacity=".4" stroke-width="1.6"/>
    </g>
  </svg>

  <!-- Dedos rosados y sol asomando (abajo a la izquierda) -->
  <svg class="m-pieza m-dedos" viewBox="0 0 220 220" width="220" height="220">
    <g class="m-respira" fill="#E98C83" opacity=".35">
      <path d="M0 220L180 0H206Z"/><path d="M0 220L220 64V96Z"/><path d="M0 220L96 0H118Z"/><path d="M0 220L220 150V170Z"/>
    </g>
    <circle cx="0" cy="220" r="96" fill="#E8A33D" opacity=".3"/>
    <circle cx="0" cy="220" r="66" fill="#F07A45"/>
    <g>
      <rect class="m-brilla" style="--d:0s" x="74" y="132" width="9" height="9" fill="#F07A45"/>
      <rect class="m-brilla" style="--d:.8s" x="94" y="150" width="7" height="7" fill="#E8A33D"/>
      <rect class="m-brilla" style="--d:1.6s" x="58" y="114" width="6" height="6" fill="#E8A33D"/>
    </g>
  </svg>

  <!-- Eósforo, la estrella de la mañana (derecha, arriba) -->
  <svg class="m-pieza m-estrella" viewBox="0 0 120 120" width="120" height="120">
    <circle cx="60" cy="60" r="44" fill="none" stroke="#C8643B" stroke-opacity=".4" stroke-width="1.4" stroke-dasharray="2 6"/>
    <g class="m-centellea">
      <path d="M60 22L65 52 92 60 65 68 60 98 55 68 28 60 55 52Z" fill="#E8A33D"/>
      <path d="M60 38L62.5 57.5 80 60 62.5 62.5 60 82 57.5 62.5 40 60 57.5 57.5Z" fill="#FFF4DD"/>
    </g>
    <circle class="m-brilla" style="--d:.5s" cx="100" cy="30" r="3" fill="#E98C83"/>
  </svg>

  <!-- Rocío: gotas que caen despacio (derecha, en medio) -->
  <svg class="m-pieza m-rocio" viewBox="0 0 90 260" width="90" height="260">
    <defs>
      <linearGradient id="marco-gota" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#E9F2F8"/><stop offset="1" stop-color="#8FB3CC"/>
      </linearGradient>
    </defs>
    <g class="m-cae" style="--d:0s"><path d="M30 20C38 34 44 42 44 50A14 14 0 0 1 16 50C16 42 22 34 30 20Z" fill="url(#marco-gota)"/><circle cx="25" cy="49" r="3" fill="#fff"/></g>
    <g class="m-cae" style="--d:-3s"><path d="M62 80C68 91 72 97 72 103A10 10 0 0 1 52 103C52 97 56 91 62 80Z" fill="url(#marco-gota)"/><circle cx="58" cy="102" r="2.2" fill="#fff"/></g>
    <g class="m-cae" style="--d:-6s"><path d="M36 150C40 157 43 161 43 165A7 7 0 0 1 29 165C29 161 32 157 36 150Z" fill="url(#marco-gota)"/></g>
    <rect class="m-brilla" style="--d:1s" x="58" y="190" width="6" height="6" fill="#8FB3CC"/>
  </svg>

  <!-- La cigarra de Titono (abajo a la derecha) -->
  <svg class="m-pieza m-cigarra" viewBox="0 0 90 90" width="90" height="90">
    <g transform="rotate(-30 45 45)">
      <path d="M45 18C52 18 56 26 56 36V58C56 66 51 74 45 74C39 74 34 66 34 58V36C34 26 38 18 45 18Z" fill="#6F7B3F"/>
      <path d="M45 18C52 18 56 26 56 36V58C56 66 51 74 45 74Z" fill="#000" opacity=".12"/>
      <path d="M40 32C26 34 16 52 22 78C30 68 38 54 41 36Z" fill="#CFE0EC" opacity=".85"/>
      <path d="M50 32C64 34 74 52 68 78C60 68 52 54 49 36Z" fill="#CFE0EC" opacity=".85"/>
      <path d="M26 52L38 40M64 52L52 40" stroke="#8FB3CC" stroke-width="1.2"/>
      <circle cx="39" cy="22" r="3.5" fill="#1B1412"/><circle cx="51" cy="22" r="3.5" fill="#1B1412"/>
      <path d="M40 46h10M40 54h10M41 62h8" stroke="#1B1412" stroke-opacity=".35" stroke-width="1.6"/>
    </g>
  </svg>
</div>

<style>
  .marco{position:fixed;inset:0;z-index:50;pointer-events:none;overflow:hidden;}
  .m-pieza{position:absolute;}
  .m-rueda{left:-96px;top:140px;}
  .m-ala{left:-62px;top:58%;}
  .m-dedos{left:-20px;bottom:-20px;}
  .m-estrella{right:-58px;top:120px;}
  .m-rocio{right:-30px;top:44%;}
  .m-cigarra{right:6px;bottom:96px;}  /* encima del botón de WhatsApp */

  @media (prefers-reduced-motion: no-preference){
    .m-gira{transform-box:fill-box;transform-origin:center;animation:mGira 50s linear infinite;}
    .m-aletea{transform-box:fill-box;transform-origin:0 50%;animation:mAletea 5s ease-in-out infinite;}
    .m-respira{animation:mRespira 7s ease-in-out infinite alternate;}
    .m-centellea{transform-box:fill-box;transform-origin:center;animation:mCentellea 3.4s ease-in-out infinite;}
    .m-brilla{animation:mBrilla 2.8s ease-in-out infinite;animation-delay:var(--d);}
    .m-cae{animation:mCae 9s ease-in infinite;animation-delay:var(--d);}
  }
  @keyframes mGira{to{transform:rotate(360deg)}}
  @keyframes mAletea{0%,100%{transform:rotate(0)}50%{transform:rotate(-6deg)}}
  @keyframes mRespira{from{opacity:.25}to{opacity:.45}}
  @keyframes mCentellea{0%,100%{transform:scale(1) rotate(0)}50%{transform:scale(.82) rotate(12deg)}}
  @keyframes mBrilla{0%,100%{opacity:1}50%{opacity:.25}}
  @keyframes mCae{0%{transform:translateY(-10px);opacity:0}15%{opacity:1}80%{opacity:1}100%{transform:translateY(60px);opacity:0}}

  /* Entre 900 y 1280 px no hay hueco a los lados: solo los rayos y la cigarra. */
  @media (max-width:1279px){ .m-rueda,.m-ala,.m-estrella,.m-rocio{display:none;} }
  @media (max-width:900px){ .marco{display:none;} }
  @media print{ .marco{display:none;} }
</style>
