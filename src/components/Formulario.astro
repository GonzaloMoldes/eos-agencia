---
// Formulario de contacto o de diagnóstico gratuito. Envía a /api/contacto,
// que reenvía el mensaje por correo al equipo. Si el envío falla, ofrece
// WhatsApp y correo para que nadie se quede sin respuesta.
//
// Rellena «Me interesa» si la URL trae ?servicio=<slug> o ?plan=<nombre>
// (los botones de las páginas de servicio enlazan así).
//
// tipo «landing»: formulario corto de las landing pages (/lp/). El servicio va
// fijo y los botones con data-plan rellenan el plan elegido.
//
// Todos los formularios envían la página y el origen de la visita (utm_*,
// gclid, fbclid, msclkid), guardados al entrar para que lleguen aunque la
// persona navegue antes de escribir.
import { PUBLICADOS } from '../data/servicios';
import { SITIO, whatsappUrl } from '../data/sitio';

export interface Props {
  tipo?: 'contacto' | 'diagnostico' | 'landing';
  servicio?: string;      // landing: servicio fijo
  necesidades?: string[]; // landing: opciones de «¿Qué necesitas?»
  inversiones?: string[]; // landing: opciones de «¿Qué inversión mensual manejas?»
  siguientes?: { t: string; d: string }[];  // landing: «¿Qué pasa ahora?» tras enviar
  herramientas?: string[];  // landing: opciones de «¿Qué herramienta usas ahora?»
  ayudaWeb?: string;        // landing: ayuda bajo «URL de tu web»
  boton?: string;         // texto del botón de envío
}
const { tipo = 'contacto', servicio = '', necesidades = [], inversiones = [], siguientes = [], herramientas = [], ayudaWeb = 'Sin ella no podemos decirte nada útil.', boton } = Astro.props;
const diag = tipo === 'diagnostico';
const landing = tipo === 'landing';
const textoBoton = boton || (diag ? 'Pedir mi diagnóstico' : landing ? 'Quiero mi diagnóstico' : 'Enviar mensaje');
const id = `form-${tipo}`;
---
<form class="formulario" id={id} data-tipo={tipo} novalidate>
  <div class="f-fila">
    <label><span>Nombre <b aria-hidden="true">*</b></span>
      <input name="nombre" autocomplete="name" required>
    </label>
    <label><span>Correo <b aria-hidden="true">*</b></span>
      <input name="email" type="email" autocomplete="email" required>
    </label>
  </div>

  {landing ? (
    <>
      <div class="f-fila f-fila--abajo">
        {necesidades.length > 0 && (
          <label>¿Qué necesitas?
            <select name="objetivo">
              <option value="">Elige una opción</option>
              {necesidades.map((o) => <option>{o}</option>)}
            </select>
          </label>
        )}
        <label><span>URL de tu web <b aria-hidden="true">*</b> <small class="f-ayuda">{ayudaWeb}</small></span>
          <input name="web" type="url" inputmode="url" placeholder="https://" required>
        </label>
      </div>
      <div class="f-fila f-fila--abajo">
        {inversiones.length > 0 && (
          <label><span>¿Qué inversión mensual manejas? <small class="f-ayuda">Por si buscas algo fuera de nuestro rango.</small></span>
            <select name="inversion">
              <option value="">Elige una opción</option>
              {inversiones.map((o) => <option>{o}</option>)}
            </select>
          </label>
        )}
        {herramientas.length > 0 ? (
          <label>¿Qué herramienta usas ahora?
            <select name="herramienta">
              <option value="">Elige una opción</option>
              {herramientas.map((o) => <option>{o}</option>)}
            </select>
          </label>
        ) : (
          <label><span>Teléfono <small class="f-opc">(opcional)</small></span>
            <input name="telefono" type="tel" autocomplete="tel">
          </label>
        )}
      </div>
      <div class="f-fila f-fila--abajo">
        {herramientas.length > 0 && (
          <label><span>Teléfono <small class="f-opc">(opcional)</small></span>
            <input name="telefono" type="tel" autocomplete="tel">
          </label>
        )}
        <label class:list={[{ 'f-ancho': herramientas.length === 0 }]}><span>Cuéntanos lo que quieras <small class="f-opc">(opcional)</small></span>
          <textarea name="mensaje" rows={herramientas.length > 0 ? 1 : 2}></textarea>
        </label>
      </div>
      <input type="hidden" name="servicio" value={servicio}>
      <input type="hidden" name="plan" value="">
    </>
  ) : diag ? (
    <>
      <label><span>Web que quieres que revisemos <b aria-hidden="true">*</b></span>
        <input name="web" type="url" inputmode="url" placeholder="https://" required>
      </label>
      <label>¿Qué te gustaría mejorar?
        <select name="servicio">
          <option value="">Aún no lo sé, decidme vosotros</option>
          <option>Aparecer más en Google</option>
          <option>Aparecer en Google Maps (SEO local)</option>
          <option>Que la IA recomiende mi marca (GEO)</option>
          <option>Captar más contactos o ventas</option>
          <option>Ordenar mi CRM o automatizar</option>
        </select>
      </label>
      <label>Cuéntanos tu objetivo en una frase
        <textarea name="objetivo" rows="3"></textarea>
      </label>
    </>
  ) : (
    <>
      <div class="f-fila">
        <label>Empresa
          <input name="empresa" autocomplete="organization">
        </label>
        <label>Teléfono
          <input name="telefono" type="tel" autocomplete="tel">
        </label>
      </div>
      <label>Me interesa
        <select name="servicio">
          <option value="">Elige un servicio (opcional)</option>
          {PUBLICADOS.map((s) => <option value={s.nombre} data-slug={s.slug}>{s.nombre}</option>)}
          <option>Otro / no lo tengo claro</option>
        </select>
      </label>
      <label><span>Mensaje <b aria-hidden="true">*</b></span>
        <textarea name="mensaje" rows="5" required placeholder="Qué haces, qué quieres conseguir y qué herramientas usas."></textarea>
      </label>
    </>
  )}

  <!-- Trampa para bots: oculto para las personas -->
  <label class="f-trampa" aria-hidden="true">No rellenar <input name="website" tabindex="-1" autocomplete="off"></label>

  <label class="f-consent">
    <input type="checkbox" name="consent" required>
    <span>He leído la <a href="/legal/privacidad/">política de privacidad</a> y acepto que EOS Studio use mis datos para responder a mi solicitud.</span>
  </label>

  <input type="hidden" name="pagina" value="">
  <input type="hidden" name="origen" value="">

  <button class="btn btn--aurora" type="submit">{textoBoton} <span class="flecha">→</span></button>

  <div class="f-estado" role="status" aria-live="polite"></div>
  {siguientes.length > 0 && (
    <div class="f-gracias" hidden>
      <p class="f-gracias-t">¿Qué pasa ahora?</p>
      <ol>{siguientes.map((x) => <li><strong>{x.t}</strong><span>{x.d}</span></li>)}</ol>
    </div>
  )}
  <div class="f-error" hidden>
    <p>No hemos podido enviar el formulario. Escríbenos directamente y te respondemos igual:</p>
    <p><a class="btn btn--tinta" href={whatsappUrl()} target="_blank" rel="noopener">WhatsApp <span class="flecha">→</span></a> <a class="btn btn--linea" href={`mailto:${SITIO.email}`}>{SITIO.email}</a></p>
  </div>
</form>

<style>
  .formulario{display:grid;gap:16px;}
  .f-fila{display:grid;grid-template-columns:1fr 1fr;gap:16px;}
  .f-fila--abajo{align-items:end;}
  .f-ancho{grid-column:1/-1;}
  @media (max-width:600px){ .f-fila{grid-template-columns:1fr;} }
  .formulario label{display:grid;gap:7px;font-size:.9rem;font-weight:500;color:var(--tinta-2);}
  .formulario label b{color:var(--terracota);font-weight:600;}
  .formulario input:not([type=checkbox]),.formulario select,.formulario textarea{font:inherit;font-size:1rem;color:var(--tinta);padding:13px 15px;border:1px solid var(--linea-2);border-radius:14px;background:rgba(255,255,255,.85);width:100%;}
  .formulario textarea{resize:vertical;}
  .formulario input:focus,.formulario select:focus,.formulario textarea:focus{outline:2px solid var(--aurora);outline-offset:1px;border-color:transparent;}
  .formulario [aria-invalid="true"]{border-color:#B3261E;}
  .f-trampa{position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden;}
  .f-consent{display:flex !important;grid-template-columns:none;align-items:flex-start;gap:10px !important;font-weight:400 !important;font-size:.86rem !important;}
  .f-consent input{margin-top:3px;accent-color:var(--aurora);width:18px;height:18px;flex:none;}
  .formulario button{justify-self:start;}
  .formulario button[disabled]{opacity:.6;cursor:wait;}
  .f-estado{font-size:.95rem;min-height:1.4em;}
  .f-estado.ok{color:#2F6B2A;font-weight:500;}
  .f-estado.mal{color:#B3261E;}
  .f-error[hidden]{display:none;}
  .f-ayuda{display:block;font-weight:400;font-size:.8rem;color:var(--tinta-3);}
  .f-opc{font-weight:400;font-size:.8rem;color:var(--tinta-3);}
  .f-gracias[hidden]{display:none;}
  .f-gracias{border:1px solid var(--linea);border-radius:14px;padding:16px 18px;background:var(--marmol);display:grid;gap:10px;}
  .f-gracias-t{font-family:var(--etiqueta);font-size:.75rem;letter-spacing:.14em;text-transform:uppercase;color:var(--aurora-ink);}
  .f-gracias ol{list-style:none;counter-reset:paso;display:grid;gap:10px;}
  .f-gracias li{counter-increment:paso;position:relative;padding-left:36px;display:grid;font-size:.92rem;color:var(--tinta-2);}
  .f-gracias li::before{content:counter(paso);position:absolute;left:0;top:0;width:24px;height:24px;border-radius:50%;border:1px solid var(--aurora);color:var(--aurora-ink);display:grid;place-items:center;font-size:.8rem;font-weight:600;}
  .f-gracias strong{color:var(--tinta);}
  .f-error{background:rgba(255,255,255,.7);border:1px solid var(--linea);border-radius:14px;padding:16px;display:grid;gap:10px;}
  .f-error p:last-child{display:flex;flex-wrap:wrap;gap:10px;}
</style>

<script>
  // Origen de la visita: se guarda en la primera página de la sesión que lo trae.
  const CLAVES = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_term', 'utm_content', 'gclid', 'fbclid', 'msclkid'];
  const url = new URLSearchParams(location.search);
  const visto = CLAVES.filter((k) => url.get(k)).map((k) => `${k}=${url.get(k)!.slice(0, 120)}`).join(' · ');
  let origen = '';
  try {
    if (visto) sessionStorage.setItem('eos_origen', `${visto} · entrada ${location.pathname}`);
    origen = sessionStorage.getItem('eos_origen') || '';
    if (!origen && document.referrer && !document.referrer.startsWith(location.origin)) origen = `referer=${new URL(document.referrer).hostname}`;
  } catch { origen = visto; }

  // Botones de plan en las landing pages: guardan el plan y bajan al formulario.
  document.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLElement>('[data-plan]');
    if (!b) return;
    const campo = document.querySelector<HTMLInputElement>('form.formulario input[name=plan]');
    if (campo) campo.value = b.dataset.plan || '';
    window.eosEvento?.('ver_plan', { plan: b.dataset.plan, pagina: location.pathname });
  });

  for (const form of document.querySelectorAll<HTMLFormElement>('form.formulario')) {
    form.querySelector<HTMLInputElement>('input[name=pagina]')!.value = location.pathname;
    form.querySelector<HTMLInputElement>('input[name=origen]')!.value = origen;
    const estado = form.querySelector<HTMLElement>('.f-estado')!;
    const error = form.querySelector<HTMLElement>('.f-error')!;
    const boton = form.querySelector<HTMLButtonElement>('button[type=submit]')!;

    // Preselecciona el servicio o el plan que viene en la URL.
    const q = new URLSearchParams(location.search);
    const sel = form.querySelector<HTMLSelectElement>('select[name=servicio]');
    const slug = q.get('servicio');
    if (sel && slug) {
      const op = [...sel.options].find((o) => o.dataset.slug === slug);
      if (op) sel.value = op.value;
    }
    const plan = q.get('plan');
    const msg = form.querySelector<HTMLTextAreaElement>('textarea[name=mensaje]');
    if (msg && plan && !msg.value) msg.value = `Me interesa el plan ${plan}.\n\n`;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      error.hidden = true;
      estado.className = 'f-estado';
      // Validación propia, con mensajes en español.
      let primero: HTMLElement | null = null;
      for (const el of form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('[required]')) {
        const vacio = el.type === 'checkbox' ? !(el as HTMLInputElement).checked : !el.value.trim();
        const malo = vacio || (el.type === 'email' && !/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(el.value.trim()));
        el.setAttribute('aria-invalid', String(malo));
        if (malo && !primero) primero = el;
      }
      if (primero) {
        estado.textContent = 'Revisa los campos marcados: faltan datos o el correo no es válido.';
        estado.classList.add('mal');
        primero.focus();
        return;
      }

      const datos: Record<string, unknown> = Object.fromEntries(new FormData(form));
      datos.consent = true;
      datos.tipo = form.dataset.tipo;
      boton.disabled = true;
      estado.textContent = 'Enviando…';
      try {
        const r = await fetch('/api/contacto/', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(datos) });
        if (!r.ok) throw new Error(String(r.status));
        window.eosEvento?.('generate_lead', { form_tipo: form.dataset.tipo, servicio: String(datos.servicio || ''), pagina: location.pathname });
        const pagina = form.querySelector<HTMLInputElement>('input[name=pagina]')!.value;
        const servicioFijo = form.querySelector<HTMLInputElement>('input[type=hidden][name=servicio]')?.value || '';
        form.reset();
        form.querySelector<HTMLInputElement>('input[name=pagina]')!.value = pagina;
        form.querySelector<HTMLInputElement>('input[name=origen]')!.value = origen;
        const fijo = form.querySelector<HTMLInputElement>('input[type=hidden][name=servicio]');
        if (fijo) fijo.value = servicioFijo;
        estado.textContent = form.dataset.tipo !== 'contacto'
          ? '¡Recibido! Revisaremos tu web y te enviaremos el diagnóstico por correo.'
          : '¡Gracias! Hemos recibido tu mensaje y te responderemos muy pronto.';
        estado.classList.add('ok');
        const gracias = form.querySelector<HTMLElement>('.f-gracias');
        if (gracias) gracias.hidden = false;
      } catch {
        estado.textContent = '';
        error.hidden = false;
      } finally {
        boton.disabled = false;
      }
    });
  }
</script>
