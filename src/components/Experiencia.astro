---
// Franja de experiencia: de dónde venimos (equipos de marketing de grandes
// marcas) y a quién se lo traemos (pymes), más las certificaciones del equipo.
// Sin nombrar marcas: fueron empleadores, no clientes de la agencia.
import { CERTIFICACIONES } from '../data/equipo';
export interface Props { certificaciones?: boolean }
const { certificaciones = true } = Astro.props;
---
<div class="experiencia">
  <p class="exp-titulo">De las grandes marcas a tu negocio</p>
  <p class="exp-frase">Hemos trabajado dentro de los equipos de marketing de <em>grandes marcas</em>. Ahora llevamos ese camino a las pymes.</p>
  <ul class="exp-valores">
    <li><span aria-hidden="true">✦</span>Sencillo</li>
    <li><span aria-hidden="true">✦</span>Claro</li>
    <li><span aria-hidden="true">✦</span>Sin letra pequeña</li>
    <li><span aria-hidden="true">✦</span>Con la calidad de los grandes</li>
  </ul>
  {certificaciones && (
    <div class="certs">
      <p class="exp-titulo">Certificaciones del equipo</p>
      <ul>
        {CERTIFICACIONES.map((c) => (
          <li>
            {c.logo
              ? <img src={`/certificaciones/${c.logo}`} alt={`Certificación ${c.nombre}`} height="40" loading="lazy" />
              : <span class="cert-sello" aria-hidden="true">✦</span>}
            <span><strong>{c.nombre}</strong><small>{c.detalle || 'Certificación'}</small></span>
          </li>
        ))}
      </ul>
    </div>
  )}
</div>
<style>
  .experiencia{display:grid;gap:22px;}
  .exp-titulo{font-family:var(--etiqueta);letter-spacing:.1em;color:var(--tinta-2);font-size:.95rem;text-align:center;margin-inline:auto;}
  .exp-frase{font-family:var(--serif);font-size:clamp(2rem,4vw,3.3rem);line-height:1.08;letter-spacing:-.01em;color:var(--tinta);text-align:center;max-width:24ch;margin-inline:auto;}
  .exp-frase em{font-style:italic;background:var(--degradado);-webkit-background-clip:text;background-clip:text;color:transparent;}
  .exp-valores{list-style:none;display:flex;flex-wrap:wrap;justify-content:center;gap:10px 28px;color:var(--tinta-2);font-size:1.05rem;}
  .exp-valores li{display:inline-flex;align-items:center;gap:8px;}
  .exp-valores span{color:var(--terracota);font-size:.85em;}
  .certs{display:grid;gap:16px;margin-top:18px;}
  .certs ul{list-style:none;display:flex;flex-wrap:wrap;justify-content:center;gap:12px;}
  .certs li{display:flex;align-items:center;gap:12px;padding:12px 18px 12px 12px;border-radius:999px;border:1px solid var(--linea);background:rgba(255,255,255,.75);}
  .certs img{height:40px;width:auto;}
  .cert-sello{display:grid;place-items:center;width:40px;height:40px;border-radius:50%;background:var(--degradado);color:var(--vaso);font-size:1rem;}
  .certs strong{display:block;font-weight:600;font-size:.95rem;line-height:1.2;}
  .certs small{display:block;color:var(--tinta-3);font-size:.8rem;}
</style>
