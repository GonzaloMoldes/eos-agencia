---
// Escena ilustrada en línea (el SVG lo genera scripts/ilustraciones/generar.mjs).
// En línea para que use las fuentes del sitio y no cueste una petición.
const svgs = import.meta.glob('../assets/ilustraciones/*.svg', { query: '?raw', import: 'default', eager: true }) as Record<string, string>;

export interface Props { nombre: string; class?: string }
const { nombre, class: clase } = Astro.props;
const svg = svgs[`../assets/ilustraciones/${nombre}.svg`];
if (!svg) throw new Error(`Escena: no existe "${nombre}". ¿Has ejecutado npm run ilustraciones?`);
---
<figure class:list={['escena', clase]}><Fragment set:html={svg} /></figure>

<style>
  .escena{margin:0;}
  .escena :global(svg){width:100%;height:auto;overflow:visible;}

  /* Animaciones. Todo dentro de no-preference: con «reducir movimiento» la
     escena se ve completa y quieta. Las arranca .visible (IntersectionObserver
     de BaseLayout). */
  @media (prefers-reduced-motion: no-preference){
    .escena :global(.esc-respira){animation:escRespira 4.2s ease-in-out infinite;animation-delay:var(--d,0s);}
    .escena :global(.esc-sol){animation:escGira 60s linear infinite;}
    .escena :global(.esc-flota){animation:escFlota 3.6s ease-in-out infinite;}
    .escena :global(.esc-brilla){transform-box:fill-box;transform-origin:center;animation:escBrilla 2.6s ease-in-out infinite;animation-delay:calc(var(--i,0) * .7s);}
    .escena :global(.esc-late){transform-box:fill-box;transform-origin:center;animation:escLate 2.2s ease-in-out infinite;}
    .escena :global(.esc-flujo){animation:escFlujo 1.6s linear infinite;}

    :global(.js) .escena :global(.esc-burbuja){opacity:0;transform:translateY(12px) scale(.85);transform-box:fill-box;transform-origin:30% 100%;}
    :global(.js) .escena:global(.visible) :global(.esc-burbuja){animation:escPop .6s cubic-bezier(.34,1.56,.64,1) forwards;animation-delay:calc(.4s + var(--i,0) * .45s);}
    :global(.js) .escena :global(.esc-crece){transform:scaleY(.2);transform-box:fill-box;transform-origin:50% 100%;}
    :global(.js) .escena:global(.visible) :global(.esc-crece){animation:escCrece .9s cubic-bezier(.2,.8,.2,1.15) forwards;}
    :global(.js) .escena:global(.visible) :global(.esc-c2){animation-delay:.15s;}
    :global(.js) .escena:global(.visible) :global(.esc-c3){animation-delay:.3s;}
    :global(.js) .escena :global(.esc-nodo){opacity:0;}
    :global(.js) .escena:global(.visible) :global(.esc-nodo){animation:escAparece .5s ease forwards;animation-delay:calc(.2s + var(--i,0) * .25s);}
    :global(.js) .escena :global(.esc-traza){stroke-dasharray:1;stroke-dashoffset:1;}
    :global(.js) .escena:global(.visible) :global(.esc-traza){animation:escTraza .8s ease-out 1s forwards;}
    :global(.js) .escena :global(.esc-progreso){stroke-dasharray:1;stroke-dashoffset:1;}
    :global(.js) .escena:global(.visible) :global(.esc-progreso){animation:escTraza 2.4s ease-out .6s forwards;}
    :global(.js) .escena :global(.esc-tarjeta){transform:translateX(-200px);opacity:.0;}
    :global(.js) .escena:global(.visible) :global(.esc-tarjeta){animation:escTarjeta 1.1s cubic-bezier(.3,.8,.3,1) .7s forwards;}
  }
  /* El avión recorre el flujo solo donde hay offset-path; si no, no se pinta
     (quedaría en la esquina del dibujo). */
  .escena :global(.esc-avion){display:none;}
  @supports (offset-path: path('M0 0')){
    .escena :global(.esc-avion){display:inline;offset-rotate:auto;offset-distance:40%;}
    @media (prefers-reduced-motion: no-preference){
      .escena :global(.esc-avion){animation:escVuela 5s ease-in-out infinite;}
    }
  }

  @keyframes escRespira{0%,100%{transform:translateY(0)}50%{transform:translateY(-3px)}}
  @keyframes escGira{to{transform:rotate(360deg)}}
  @keyframes escFlota{0%,100%{transform:translateY(0)}50%{transform:translateY(-8px)}}
  @keyframes escBrilla{0%,100%{transform:scale(1);opacity:1}50%{transform:scale(.55);opacity:.55}}
  @keyframes escLate{0%,100%{transform:scale(1)}50%{transform:scale(1.08)}}
  @keyframes escFlujo{to{stroke-dashoffset:-.05}}
  @keyframes escPop{to{opacity:1;transform:none}}
  @keyframes escCrece{to{transform:scaleY(1)}}
  @keyframes escAparece{to{opacity:1}}
  @keyframes escTraza{to{stroke-dashoffset:0}}
  @keyframes escTarjeta{to{transform:none;opacity:1}}
  @keyframes escVuela{0%{offset-distance:0%;opacity:0}8%{opacity:1}88%{opacity:1}100%{offset-distance:100%;opacity:0}}
</style>
