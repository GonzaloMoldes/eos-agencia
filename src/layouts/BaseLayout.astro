---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CabeceraLanding from '../components/CabeceraLanding.astro';
import PieLanding from '../components/PieLanding.astro';
import Migas from '../components/Migas.astro';
import Marco from '../components/Marco.astro';
import WhatsappFlotante from '../components/WhatsappFlotante.astro';
import Cookies from '../components/Cookies.astro';
import { organizationSchema, breadcrumbSchema, BASE_URL } from '../lib/seo';
import { SITIO } from '../data/sitio';
import '../styles/global.css';

export interface Props {
  title: string;
  description: string;
  schema?: object | object[];
  noindex?: boolean;
  migaFinal?: string;
  ogType?: string;
  // Landing page (/lp/): cabecera sin menú, sin migas y pie solo con lo legal.
  landing?: { cta: string; enlaces?: { href: string; texto: string }[] };
}
const { title, description, schema, noindex = false, migaFinal, ogType = 'website', landing } = Astro.props;
const canonical = `${BASE_URL}${Astro.url.pathname}`;
// Imagen para compartir: public/og/<ruta>.png (la genera `npm run og`); si la
// página no tiene la suya, la del inicio.
import { existsSync } from 'node:fs';
const ogNombre = Astro.url.pathname.replace(/^\/|\/$/g, '').replace(/\//g, '-') || 'inicio';
const ogImagen = `${BASE_URL}/og/${existsSync(`public/og/${ogNombre}.png`) ? ogNombre : 'inicio'}.png`;
const migasSchema = landing ? null : breadcrumbSchema(Astro.url.pathname, migaFinal);
const schemas = [organizationSchema, migasSchema, ...(Array.isArray(schema) ? schema : schema ? [schema] : [])].filter(Boolean);
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  {!Astro.url.pathname.startsWith('/404') && <link rel="canonical" href={canonical} />}
  {noindex
    ? <meta name="robots" content="noindex, follow" />
    : <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large" />}
  <meta name="theme-color" content="#F4F1EB" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

  <meta property="og:type" content={ogType} />
  <meta property="og:locale" content="es_ES" />
  <meta property="og:site_name" content={SITIO.nombre} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta property="og:image" content={ogImagen} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={title} />
  <meta name="twitter:image" content={ogImagen} />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

  <link rel="preload" href="/fonts/instrument-serif-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/inter-tight-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />

  {schemas.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  <script is:inline>document.documentElement.classList.add('js')</script>
</head>
<body>
  <a class="saltar" href="#contenido">Saltar al contenido</a>
  <div class="dia" aria-hidden="true"></div>
  {landing ? <CabeceraLanding cta={landing.cta} enlaces={landing.enlaces} /> : <><Header /><Migas final={migaFinal} /></>}
  <main id="contenido">
    <slot />
  </main>
  {landing ? <PieLanding /> : <Footer />}
  <Marco />
  <WhatsappFlotante />
  <Cookies />

  <script>
    // Entrada suave de los bloques marcados con .aparece y arranque de las
    // escenas ilustradas (.escena recibe .visible y eso dispara sus animaciones).
    const io = new IntersectionObserver((entradas) => {
      for (const e of entradas) if (e.isIntersecting) { e.target.classList.add('visible'); io.unobserve(e.target); }
    }, { rootMargin: '0px 0px -8% 0px' });
    document.querySelectorAll('.aparece, .escena').forEach((el) => io.observe(el));
  </script>
</body>
</html>
